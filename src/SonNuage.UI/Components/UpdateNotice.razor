@implements IDisposable
@inject ApiClient Api
@inject IPlatformInfo Platform
@inject NavigationManager Nav
@inject IPlayer Player

@* Web : l'interface est chargée une fois et ne se recharge jamais d'elle-même. Après un déploiement, on le dit. *@
@if (_outdated)
{
    <div class="update-notice" role="status">
        <span>@L["app.updateAvailable"]</span>
        <button class="btn primary" @onclick="Reload">@L["app.reload"]</button>
    </div>
}

@code {
    private static readonly TimeSpan Interval = TimeSpan.FromMinutes(2);

    private readonly UpdateWatch _watch = new();
    private bool _outdated;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        if (!Platform.ServedByServer) return;
        _watch.Saw(await BuildAsync());
        _timer = new Timer(_ => InvokeAsync(CheckAsync), null, Interval, Interval);
    }

    private async Task CheckAsync()
    {
        if (_outdated) return;
        if (_watch.Saw(await BuildAsync()))
        {
            _outdated = true;
            StateHasChanged();
        }
    }

    private async Task<string?> BuildAsync()
    {
        try
        {
            return (await Api.InfoAsync())?.Build;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // Serveur en cours de redémarrage : on réessaiera.
            return null;
        }
    }

    private async Task Reload()
    {
        if (Player is IRestorablePlayer restorable) await restorable.PrepareReloadAsync();
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    public void Dispose() => _timer?.Dispose();
}
