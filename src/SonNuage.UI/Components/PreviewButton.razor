@* Écoute d'un extrait de 30 s d'une vidéo YouTube avant de la demander. Un seul extrait à la fois (PreviewPlayer). *@
@implements IDisposable
@inject PreviewPlayer Preview
@inject ApiClient Api
@inject UiState Ui
@inject IJSRuntime JS

@{ var state = Preview.StateOf(VideoId); }
<button type="button" class="btn compact preview-btn @(state != PreviewState.Idle ? "on" : null)" aria-pressed="@(state != PreviewState.Idle ? "true" : "false")"
        title="@L["requests.previewHint"]" @onclick="ToggleAsync">
    @if (state == PreviewState.Loading)
    {
        <Logo Size="16" Animated="true" /> @L["requests.previewLoading"]
    }
    else if (state == PreviewState.Playing)
    {
        <Icon Name="pause" Size="16" /> @L["requests.previewStop"]
    }
    else
    {
        <Icon Name="play" Size="16" /> @L["requests.preview"]
    }
</button>

@code {
    [Parameter, EditorRequired] public string VideoId { get; set; } = "";
    [Parameter] public double? DurationSeconds { get; set; }

    private JsPreviewAudio? _audio;

    protected override void OnInitialized() => Preview.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private Task ToggleAsync()
    {
        _audio ??= new JsPreviewAudio(JS, Preview);
        return Preview.ToggleAsync(VideoId, () => Api.PreviewUrlAsync(VideoId, DurationSeconds), _audio,
            () => Ui.Notify(L["requests.previewFailed"], true));
    }

    public void Dispose()
    {
        Preview.Changed -= OnChanged;
        // Page quittée pendant l'extrait : on l'arrête, il n'aurait plus de bouton pour l'arrêter.
        if (Preview.VideoId == VideoId && _audio is not null) _ = Preview.StopAsync();
        _audio?.Dispose();
    }
}
