@implements IDisposable
@inject NavigationManager Nav

@if (Open)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <header class="modal-header">
                <h2>@Title</h2>
                <button class="icon-btn" title="@L["common.close"]" @onclick="Close"><Icon Name="close" /></button>
            </header>
            <div class="modal-body">@ChildContent</div>
            @if (Footer is not null)
            {
                <footer class="modal-footer">@Footer</footer>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    private IDisposable? _backHandler;

    protected override void OnInitialized() => _backHandler = Nav.CloseOnBack(() => Open, () => _ = InvokeAsync(Close));

    private Task Close() => OpenChanged.InvokeAsync(false);

    public void Dispose() => _backHandler?.Dispose();
}
