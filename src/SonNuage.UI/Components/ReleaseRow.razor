@* Parutions des artistes de la bibliothèque (nouveautés) : pochette, titre, artiste, date et type. Déjà dans la
   bibliothèque : lien vers l'album. Sinon « Importer » (admin) ou « Demander » (contributeur), par la demande d'album
   habituelle ; une parution à venir n'a que sa date. Une parution sortie et absente de la bibliothèque a son extrait de
   30 s sur la pochette (contributeurs et admins), comme les titres de la découverte. *@
@inject ApiClient Api
@inject AuthSession Auth
@inject UiState Ui

<div class="disc-row release-row">
    @foreach (var r in Releases)
    {
        var asked = _asked.Contains(r.ReleaseGroupId);
        <article @key="r.ReleaseGroupId" class="disc-card release-card">
            <div class="disc-thumb square">
                @if (CoverUrl(r) is { } url && !_noCover.Contains(r.ReleaseGroupId))
                {
                    <img src="@url" alt="" loading="lazy" @onerror="() => _noCover.Add(r.ReleaseGroupId)" />
                }
                else
                {
                    <span class="disc-placeholder"><Icon Name="album" Size="40" /></span>
                }
                @if (r.AlbumId is null && !r.Upcoming && Auth.CanRequest)
                {
                    <PreviewButton VideoId="@($"release:{r.ReleaseGroupId}")" Url="() => Api.ReleasePreviewUrlAsync(r.ReleaseGroupId)"
                                   FailedMessage="@L["releases.previewFailed"]" Overlay="true" />
                }
                @if (r.AlbumId is not null)
                {
                    <span class="badge good disc-badge">@L["releases.inLibrary"]</span>
                }
                else if (r.Upcoming)
                {
                    <span class="badge disc-badge">@L["releases.upcoming"]</span>
                }
            </div>
            <div class="disc-body">
                <span class="disc-title" title="@r.Title">@r.Title</span>
                @if (ShowArtist)
                {
                    <a class="muted small disc-sub" href="artist/@r.ArtistId">@r.ArtistName</a>
                }
                <span class="muted small disc-sub">@L[$"releases.type.{r.Type}"]@(r.Date is { } d ? $" · {DateText(d)}" : "")</span>
            </div>
            <div class="disc-actions">
                @if (r.AlbumId is { } albumId)
                {
                    <a class="btn compact" href="album/@albumId"><Icon Name="library" Size="16" /> @L["releases.open"]</a>
                }
                else if (r.Upcoming)
                {
                    <span class="btn compact disc-state"><Icon Name="calendar" Size="16" /> @(r.Date is { } when ? DateText(when) : L["releases.upcoming"])</span>
                }
                else if (asked)
                {
                    <span class="btn compact disc-state"><Icon Name="inbox" Size="16" /> @L["requests.asked"]</span>
                }
                else if (Auth.CanRequest)
                {
                    <button class="btn compact primary" disabled="@_sending" title="@L["releases.askHint", ("album", r.Title)]" @onclick="() => AskAsync(r)">
                        <Icon Name="add" Size="16" /> @(Auth.IsAdmin ? L["releases.import"] : L["requests.ask"])
                    </button>
                }
            </div>
        </article>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ArtistReleaseDto> Releases { get; set; } = [];
    [Parameter] public bool ShowArtist { get; set; } = true;

    private readonly HashSet<Guid> _asked = [];
    private readonly HashSet<Guid> _noCover = [];
    private bool _sending;

    /// <summary>Pochette de l'album s'il est déjà là ; sinon celle de la parution, relayée par le serveur.</summary>
    private string? CoverUrl(ArtistReleaseDto r) => r.AlbumId is { } albumId ? Api.CoverUrl(albumId, 300) : Api.ReleaseCoverUrl(r.ReleaseGroupId);

    /// <summary>Date complète dans la langue de l'interface ; date partielle (« 2026 ») telle quelle.</summary>
    private string DateText(string date)
    {
        if (!DateOnly.TryParseExact(date, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var day))
            return date;
        var local = day.ToDateTime(TimeOnly.MinValue);
        return L.Date(new DateTimeOffset(local, TimeZoneInfo.Local.GetUtcOffset(local)));
    }

    private async Task AskAsync(ArtistReleaseDto release)
    {
        _sending = true;
        try
        {
            await Api.RequestAlbumAsync(new CreateAlbumRequest(release.ArtistName, release.Title));
            _asked.Add(release.ReleaseGroupId);
            Ui.Notify(L["discover.albumSent", ("album", release.Title)]);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
        _sending = false;
    }
}
