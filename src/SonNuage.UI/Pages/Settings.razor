@page "/settings"
@inject AuthSession Auth
@inject AccountStore Accounts
@inject ApiClient Api
@inject PlaybackSettings Playback
@inject IPlayer Player
@inject IPlatformInfo Platform
@inject IServerEndpoint Endpoint
@inject UiState Ui

<PageTitle>@L["nav.settings"] · SonNuage</PageTitle>

<div class="page narrow">
    <header class="page-header"><h1>@L["nav.settings"]</h1></header>

    @* Sur ordinateur, l'administration est aussi dans la pastille du compte ; sur mobile (sans pastille), seulement ici. *@
    @if (Auth.IsAdmin)
    {
        <section class="panel">
            <h2>@L["nav.admin"]</h2>
            <p class="muted">@L["settings.adminHint"]</p>
            <a class="btn primary" href="admin"><Icon Name="admin" Size="18" /> @L["settings.openAdmin"]</a>
        </section>
    }

    <section class="panel">
        <h2>@L["settings.language"]</h2>
        <label class="field">
            <span>@L["settings.language"]</span>
            <select class="input" value="@L.Language" @onchange="e => SetLanguageAsync(e.Value?.ToString())">
                @foreach (var lang in L.Available)
                {
                    <option value="@lang.Code">@lang.Name</option>
                }
            </select>
            <small class="muted">@L["settings.languageHint"]</small>
        </label>
    </section>

    <section class="panel">
        <h2>@L["settings.audioQuality"]</h2>
        @if (_info is { TranscodingAvailable: false })
        {
            <p class="muted">@L["settings.noTranscoding"]</p>
        }
        <label class="field">
            <span>@(Platform.HasMeteredNetworkDetection ? L["settings.onWifi"] : L["settings.playbackQuality"])</span>
            <select class="input" @bind="_quality">
                @foreach (var q in Qualities)
                {
                    <option value="@q.Id">@L["quality." + q.Id]</option>
                }
            </select>
        </label>
        @if (Platform.HasMeteredNetworkDetection)
        {
            <label class="field">
                <span>@L["settings.onMobile"]</span>
                <select class="input" @bind="_mobileQuality">
                    @foreach (var q in Qualities)
                    {
                        <option value="@q.Id">@L["quality." + q.Id]</option>
                    }
                </select>
            </label>
        }
        <label class="field">
            <span>@L["settings.prefetch"]</span>
            <input class="input" type="number" min="0" max="10" @bind="_prefetch" />
            <small class="muted">@L["settings.prefetchHint"]</small>
        </label>
        @if (Player.SupportsCrossfade)
        {
            <label class="field">
                <span>@L["settings.crossfade"] : <strong>@(_crossfade == 0 ? L["settings.crossfadeOff"] : L["settings.seconds", ("value", _crossfade.ToString("0.0"))])</strong></span>
                <input type="range" min="0" max="@PlaybackSettings.MaxCrossfadeSeconds" step="0.1" @bind="_crossfade" @bind:event="oninput" />
                <small class="muted">@L["settings.crossfadeHint"]</small>
            </label>
        }
        <div class="field">
            <label class="field check">
                <input type="checkbox" @bind="_infinite" />
                <span>@L["settings.infinitePlay"]</span>
            </label>
            <small class="muted">@L["settings.infinitePlayHint"]</small>
        </div>
        @if (_infinite)
        {
            <label class="field">
                <span>@L["settings.infiniteAhead"]</span>
                <input class="input" type="number" min="1" max="@InfinitePlay.MaxAhead" @bind="_ahead" />
            </label>
        }
        <button class="btn primary" @onclick="SavePlaybackAsync">@L["common.save"]</button>
    </section>

    <section class="panel">
        <h2>@L["settings.account"]</h2>
        <p>@L["settings.loggedInAs"] <strong>@Auth.User?.Username</strong> (@L[RoleLabels.Key(Auth.User?.Role, "settings")])
            @if (Endpoint.IsConfigurable) { <span> @L["settings.onServer", ("host", Endpoint.BaseAddress?.Host)]</span> }</p>
        <form class="stack" @onsubmit="ChangePasswordAsync" @onsubmit:preventDefault="true">
            <input class="input" type="password" placeholder="@L["settings.currentPassword"]" @bind="_current" autocomplete="current-password" required />
            <input class="input" type="password" placeholder="@L["settings.newPassword", ("min", 8)]" @bind="_next" autocomplete="new-password" minlength="8" required />
            <button class="btn" type="submit">@L["settings.changePassword"]</button>
        </form>
        @if (!Accounts.IsMultiAccount)
        {
            <button class="btn danger" @onclick="Auth.LogoutAsync"><Icon Name="logout" Size="18" /> @L["settings.logout"]</button>
        }
    </section>

    @if (Accounts.IsMultiAccount)
    {
        <section class="panel">
            <h2>@L["accounts.title"]</h2>
            <p class="muted small">@L["accounts.hint"]</p>
            <ul class="accounts">
                @foreach (var account in Accounts.Accounts)
                {
                    var active = account.Id == Accounts.Active?.Id;
                    <li class="@(active ? "active" : "")">
                        <div class="account-name">
                            <strong>@account.Username</strong>
                            <span class="muted small">@account.Host@(active ? $" · {L["accounts.active"]}" : "")</span>
                        </div>
                        <div class="row">
                            @if (!active)
                            {
                                <button class="btn" @onclick="() => SwitchAsync(account)">@L["accounts.use"]</button>
                            }
                            <button class="btn danger" title="@L["accounts.logoutTitle"]" @onclick="() => LogoutAsync(account)"><Icon Name="logout" Size="18" /> @L["accounts.logout"]</button>
                        </div>
                    </li>
                }
            </ul>
            <button class="btn" @onclick="Accounts.BeginAdd"><Icon Name="add" Size="18" /> @L["accounts.add"]</button>
        </section>
    }

    @* Réglages propres à l'hôte (appli de bureau : lancement avec la session, mises à jour). *@
    <HostComponents Types="Platform.SettingsSections" />

    <DevicesSettings />

    <SubsonicApps />

    <ListenBrainzSettings />

    <section class="panel">
        <h2>@L["nav.help"]</h2>
        <p class="muted">@L["settings.helpHint"]</p>
        <a class="btn" href="help"><Icon Name="help" Size="18" /> @L["settings.openHelp"]</a>
        <VersionLine />
    </section>
</div>

@code {
    private ServerInfoDto? _info;
    private string _quality = "";
    private string _mobileQuality = "";
    private int _prefetch;
    private double _crossfade;
    private bool _infinite;
    private int _ahead;
    private string _current = "";
    private string _next = "";

    private IReadOnlyList<QualityDto> Qualities => _info?.Qualities ?? [new QualityDto("original", "original", "original", null)];

    protected override async Task OnInitializedAsync()
    {
        _quality = Playback.Quality.ToWire();
        _mobileQuality = Playback.MobileQuality.ToWire();
        _prefetch = Playback.PrefetchCount;
        _crossfade = Playback.CrossfadeSeconds;
        _infinite = Playback.InfinitePlay;
        _ahead = Playback.InfiniteAhead;
        try
        {
            _info = await Api.InfoAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
        }
    }

    private async Task SavePlaybackAsync()
    {
        StreamQualities.TryParse(_quality, out var q);
        StreamQualities.TryParse(_mobileQuality, out var m);
        await Playback.SaveAsync(q, m, _prefetch, _crossfade, _infinite, _ahead);
        await Player.ReloadSettingsAsync();
        Ui.Notify(L["settings.saved"]);
    }

    private async Task SetLanguageAsync(string? code)
    {
        if (string.IsNullOrEmpty(code)) return;
        try
        {
            // Sur le compte d'abord (suivie sur les autres appareils), puis ici : l'interface se redessine.
            if (await Api.SetLanguageAsync(code) is { } user) await Auth.UpdateUserAsync(user);
            await L.SetAsync(code);
            Ui.Notify(L["settings.languageSaved"]);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }

    private async Task SwitchAsync(Account account)
    {
        await Accounts.SwitchAsync(account.Id);
        Ui.Notify(L["accounts.switched", ("account", account.Label)]);
    }

    private async Task LogoutAsync(Account account)
    {
        await Auth.LogoutAsync(account);
        Ui.Notify(L["accounts.loggedOut", ("account", account.Label)]);
    }

    private async Task ChangePasswordAsync()
    {
        try
        {
            await Api.ChangePasswordAsync(_current, _next);
            Ui.Notify(L["settings.passwordChanged"]);
            await Auth.LogoutAsync();
        }
        catch (ApiException ex)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }
}
