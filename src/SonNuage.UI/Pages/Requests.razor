@page "/requests"
@inject ApiClient Api
@inject AuthSession Auth
@inject UiState Ui
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject PageMemory Memory
@implements IDisposable

<PageTitle>@L["requests.title"] · SonNuage</PageTitle>

<div class="page">
    <header class="page-header">
        <h1>@L["requests.title"]</h1>
        @if (Auth.CanRequest) { <a class="btn" href="discover"><Icon Name="explore" Size="18" /> @L["discover.title"]</a> }
    </header>
    @if (!Auth.CanRequest)
    {
        <div class="empty"><p>@L["requests.restricted"]</p></div>
    }
    else
    {
        <section class="panel">
            <p class="quota-line">
                @if (_quota is { } q)
                {
                    <span class="strong">@(q.Limit is { } limit ? L["requests.quota", ("used", q.Used), ("limit", limit)] : L["requests.noQuota"])</span>
                    <span class="muted small">@(q.AutoApproved ? L["requests.autoHint"] : L["requests.reviewHint"])</span>
                }
            </p>
            <div class="segmented request-mode" role="group" aria-label="@L["requests.modeLabel"]">
                <button type="button" class="@(_mode == Mode.Catalog ? "on" : null)" @onclick="() => SetMode(Mode.Catalog)">@L["requests.modeCatalog"]</button>
                <button type="button" class="@(_mode == Mode.Match ? "on" : null)" @onclick="() => SetMode(Mode.Match)">@L["requests.modeMatch"]</button>
                <button type="button" class="@(_mode == Mode.Free ? "on" : null)" @onclick="() => SetMode(Mode.Free)">@L["requests.modeFree"]</button>
            </div>
            @if (_mode == Mode.Catalog)
            {
                <form class="inline-form" @onsubmit="CatalogAsync" @onsubmit:preventDefault="true">
                    <input class="input" placeholder="@L["requests.catalogPlaceholder"]" @bind="_catalogQuery" aria-label="@L["requests.catalogPlaceholder"]" />
                    <button class="btn primary" type="submit" disabled="@(_searching || string.IsNullOrWhiteSpace(_catalogQuery))"><Icon Name="search" Size="18" /> @L["yt.explore.search"]</button>
                </form>
                <p class="muted small">@L["requests.catalogHint"]</p>
            }
            else if (_mode == Mode.Match)
            {
                <form class="inline-form" @onsubmit="TypedMatchAsync" @onsubmit:preventDefault="true">
                    <input class="input" placeholder="@L["requests.artist"]" @bind="_artist" aria-label="@L["requests.artist"]" />
                    <input class="input" placeholder="@L["requests.songTitle"]" @bind="_title" aria-label="@L["requests.songTitle"]" />
                    <button class="btn primary" type="submit" disabled="@(_searching || string.IsNullOrWhiteSpace(_artist) || string.IsNullOrWhiteSpace(_title))"><Icon Name="search" Size="18" /> @L["requests.matchSearch"]</button>
                </form>
                <p class="muted small">@L["requests.matchHint"]</p>
            }
            else
            {
                <form class="inline-form" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                    <input class="input" placeholder="@L["requests.searchPlaceholder"]" @bind="_query" aria-label="@L["requests.searchPlaceholder"]" />
                    <div class="segmented" role="group" aria-label="Source">
                        <button type="button" class="@(_music ? "on" : null)" @onclick="() => _music = true">YouTube Music</button>
                        <button type="button" class="@(!_music ? "on" : null)" @onclick="() => _music = false">YouTube</button>
                    </div>
                    <button class="btn primary" type="submit" disabled="@(_searching || string.IsNullOrWhiteSpace(_query))"><Icon Name="search" Size="18" /> @L["yt.explore.search"]</button>
                </form>
                <p class="muted small">@L["requests.searchHint"]</p>
            }

            @if (_searching)
            {
                <div class="empty"><Logo Size="16" Animated="true" /> @L["yt.explore.searching"]</div>
            }
            else if (_mode == Mode.Catalog && _discography is { } disco)
            {
                <div class="catalog-head" @ref="_head">
                    <button class="btn compact" @onclick="() => _discography = null"><Icon Name="arrow-back" Size="16" /> @L["requests.catalogBack"]</button>
                    <h3>@disco.Artist.Name · @L["requests.catalogDiscography"]</h3>
                </div>
                @if (disco.Albums is null)
                {
                    <div class="empty"><Logo Size="16" Animated="true" /> @L["yt.explore.searching"]</div>
                }
                else
                {
                    <div class="catalog-filters" role="group" aria-label="@L["requests.catalogFilter"]">
                        @foreach (var type in TypesOf(disco.Albums))
                        {
                            @Filter(TypeLabel(type), disco.Albums.Count(a => TypeOf(a) == type), _hiddenTypes, type)
                        }
                    </div>
                    <ul class="yt-list requests catalog">
                        @foreach (var a in disco.Albums.Where(a => !_hiddenTypes.Contains(TypeOf(a)))) { @AlbumRow(a) }
                    </ul>
                }
            }
            else if (_mode == Mode.Catalog && _catalog is { } catalog)
            {
                @if (catalog.Tracks.Count + catalog.Albums.Count + catalog.Artists.Count == 0)
                {
                    <p class="muted">@L["requests.catalogEmpty"]</p>
                }
                else
                {
                    <div class="catalog-filters" role="group" aria-label="@L["requests.catalogFilter"]">
                        @Filter(L["requests.catalogTracks"], catalog.Tracks.Count, _hiddenKinds, KindTracks)
                        @Filter(L["requests.catalogAlbums"], catalog.Albums.Count, _hiddenKinds, KindAlbums)
                        @Filter(L["requests.catalogArtists"], catalog.Artists.Count, _hiddenKinds, KindArtists)
                    </div>
                }
                @if (catalog.Tracks.Count > 0 && !_hiddenKinds.Contains(KindTracks))
                {
                    <h3 class="catalog-title">@L["requests.catalogTracks"]</h3>
                    <ul class="yt-list requests catalog">
                        @foreach (var t in catalog.Tracks)
                        {
                            <li class="@(t.InLibrary ? "known" : null)">
                                @Cover(t.CoverUrl, "album")
                                <span class="grow">
                                    <span class="strong">@t.Title</span>
                                    <span class="muted small block">@t.Artist@(t.Album is { } al ? $" · {al}" : "")@(t.DurationSeconds is { } dur ? $" · {Format.Duration(dur)}" : "")</span>
                                </span>
                                <span class="row-actions">
                                    @if (t.InLibrary) { <span class="badge good">@L["requests.onServer"]</span> }
                                    <button class="btn compact @(t.InLibrary ? null : "primary")" title="@L["requests.catalogFindHint"]" @onclick="() => FindAsync(t)"><Icon Name="search" Size="16" /> @L["requests.catalogFind"]</button>
                                </span>
                            </li>
                        }
                    </ul>
                }
                @if (catalog.Albums.Count > 0 && !_hiddenKinds.Contains(KindAlbums))
                {
                    <h3 class="catalog-title">@L["requests.catalogAlbums"]</h3>
                    <ul class="yt-list requests catalog">
                        @foreach (var a in catalog.Albums) { @AlbumRow(a) }
                    </ul>
                }
                @if (catalog.Artists.Count > 0 && !_hiddenKinds.Contains(KindArtists))
                {
                    <h3 class="catalog-title">@L["requests.catalogArtists"]</h3>
                    <ul class="yt-list requests catalog">
                        @foreach (var artist in catalog.Artists)
                        {
                            <li>
                                @Cover(artist.PictureUrl, "artist", round: true)
                                <span class="grow">
                                    <span class="strong">@artist.Name</span>
                                    @if (artist.AlbumCount is { } n) { <span class="muted small block">@L["requests.catalogAlbumCount", ("count", n)]</span> }
                                </span>
                                <span class="row-actions">
                                    @if (artist.InLibrary) { <span class="badge good">@L["requests.onServer"]</span> }
                                    <button class="btn compact" @onclick="() => DiscographyAsync(artist)"><Icon Name="album" Size="16" /> @L["requests.catalogDiscography"]</button>
                                </span>
                            </li>
                        }
                    </ul>
                }
            }
            else if (_mode == Mode.Match && _match is { } match)
            {
                <p class="match-summary">
                    @if (match.Candidates.Count == 0)
                    {
                        <span class="muted">@L["requests.noResult"]</span>
                    }
                    else if (match.Sure)
                    {
                        <span class="badge good">@L["requests.matchSure"]</span>
                    }
                    else
                    {
                        <span class="badge warn">@L["requests.matchUnsure"]</span>
                    }
                    @if (match.DurationSeconds is { } expected)
                    {
                        <span class="muted small">@(match.DurationFromMusicBrainz ? L["requests.expectedMb", ("duration", Format.Duration(expected))] : L["requests.expected", ("duration", Format.Duration(expected))])</span>
                    }
                </p>
                <ul class="yt-list requests">
                    @foreach (var (c, i) in match.Candidates.Select((c, i) => (c, i)))
                    {
                        @Row(c.Video, c.Score, i == 0 && match.Sure)
                    }
                </ul>
            }
            else if (_mode == Mode.Free && _results is { } results)
            {
                @if (results.Entries.Count == 0)
                {
                    <p class="muted">@L["requests.noResult"]</p>
                }
                <ul class="yt-list requests">
                    @foreach (var v in results.Entries)
                    {
                        @Row(v, null, false)
                    }
                </ul>
            }
        </section>

        <section class="panel">
            <h2>@L["requests.mine"]</h2>
            @if (_mine.Count == 0)
            {
                <p class="muted">@L["requests.none"]</p>
            }
            else
            {
                <RequestList Items="_mine" />
                @if (_mine.Count < _total)
                {
                    <button class="btn" @onclick="MoreAsync">@L["requests.more"]</button>
                }
            }
        </section>
    }
</div>

@code {
    private const int Page = 50;
    private string _query = "";
    private bool _music = true;
    private enum Mode { Catalog, Match, Free }
    private Mode _mode = Mode.Catalog;
    private string _catalogQuery = "";
    private CatalogSearchDto? _catalog;
    private (CatalogArtistDto Artist, List<CatalogAlbumDto>? Albums)? _discography;
    private readonly HashSet<long> _albumsAsked = [];
    // Durée connue par le catalogue pour le titre cherché ; sinon le serveur la demande à MusicBrainz.
    private double? _duration;
    private ElementReference _head;
    private const string KindTracks = "tracks", KindAlbums = "albums", KindArtists = "artists";
    // Cases décochées : gardées d'une recherche (et d'un artiste) à l'autre.
    private readonly HashSet<string> _hiddenKinds = [];
    private readonly HashSet<string> _hiddenTypes = [];
    private static readonly string[] KnownTypes = ["album", "ep", "single", "compile"];
    private bool _revealHead;
    private string _artist = "";
    private string _title = "";
    private MatchResultDto? _match;
    private bool _searching;
    private YoutubeListingDto? _results;
    private readonly HashSet<string> _asked = [];
    private string? _sending;
    private RequestQuotaDto? _quota;
    private List<DownloadRequestDto> _mine = [];
    private int _total;

    // Correspondance ouverte depuis un titre du catalogue : le retour ramène aux résultats du catalogue.
    private bool _fromCatalog;
    private IDisposable? _backHandler;

    /// <summary>Ce que la page affichait, retrouvé par le retour arrière (voir PageMemory).</summary>
    private sealed record Snapshot(Mode Mode, string CatalogQuery, CatalogSearchDto? Catalog, (CatalogArtistDto Artist, List<CatalogAlbumDto>? Albums)? Discography,
        string Artist, string Title, double? Duration, MatchResultDto? Match, bool FromCatalog, string Query, bool Music, YoutubeListingDto? Results,
        long[] AlbumsAsked, string[] Asked, string[] HiddenKinds, string[] HiddenTypes);

    private const string MemoryKey = "requests";

    private void SetMode(Mode mode)
    {
        _mode = mode;
        _fromCatalog = false;
    }

    [SupplyParameterFromQuery(Name = "artist")] public string? ArtistQuery { get; set; }
    [SupplyParameterFromQuery(Name = "title")] public string? TitleQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.CanRequest) return;
        // Retour : la discographie ou la correspondance ouverte depuis le catalogue se referme sur ses résultats.
        _backHandler = Nav.CloseOnBack(() => _mode == Mode.Catalog && _discography is not null || _mode == Mode.Match && _fromCatalog, () =>
        {
            if (_mode == Mode.Match) SetMode(Mode.Catalog);
            else _discography = null;
            InvokeAsync(StateHasChanged);
        });
        if (!string.IsNullOrWhiteSpace(ArtistQuery) && !string.IsNullOrWhiteSpace(TitleQuery))
        {
            _mode = Mode.Match;
            _artist = ArtistQuery;
            _title = TitleQuery;
            _ = InvokeAsync(async () =>
            {
                await MatchAsync();
                StateHasChanged();
            });
        }
        else if (await Memory.RecallAsync<Snapshot>(JS, MemoryKey) is { } kept)
        {
            Restore(kept);
        }
        await RunAsync(async () =>
        {
            _quota = await Api.RequestQuotaAsync();
            var page = await Api.MyRequestsAsync(0, Page);
            _mine = page?.Items.ToList() ?? [];
            _total = page?.Total ?? 0;
        });
    }

    private void Restore(Snapshot kept)
    {
        (_mode, _catalogQuery, _catalog, _discography) = (kept.Mode, kept.CatalogQuery, kept.Catalog, kept.Discography);
        (_artist, _title, _duration, _match, _fromCatalog) = (kept.Artist, kept.Title, kept.Duration, kept.Match, kept.FromCatalog);
        (_query, _music, _results) = (kept.Query, kept.Music, kept.Results);
        _albumsAsked.UnionWith(kept.AlbumsAsked);
        _asked.UnionWith(kept.Asked);
        _hiddenKinds.UnionWith(kept.HiddenKinds);
        _hiddenTypes.UnionWith(kept.HiddenTypes);
    }

    public void Dispose()
    {
        _backHandler?.Dispose();
        if (!Auth.CanRequest) return;
        Memory.Keep(MemoryKey, new Snapshot(_mode, _catalogQuery, _catalog, _discography, _artist, _title, _duration, _match, _fromCatalog,
            _query, _music, _results, [.. _albumsAsked], [.. _asked], [.. _hiddenKinds], [.. _hiddenTypes]));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_revealHead || _discography is null) return;
        _revealHead = false;
        await JS.InvokeVoidAsync("sonnuage.reveal", _head);
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query)) return;
        _searching = true;
        _results = null;
        await RunAsync(async () => _results = await Api.RequestSearchAsync(_query.Trim(), _music));
        _searching = false;
    }

    private RenderFragment Row(YoutubeVideoDto v, int? score, bool best) => __builder =>
    {
        var known = v.ImportStatus is not null and not "Failed" and not "Skipped";
        var asked = _asked.Contains(v.VideoId);
        <li @key="v.VideoId" class="@(known ? "known" : best ? "selected" : null)">
            <img class="yt-thumb" src="@v.ThumbnailUrl" alt="" loading="lazy" />
            <span class="grow">
                <span class="strong">@v.Title</span>
                <span class="muted small block">@v.Channel@(v.DurationSeconds is { } dur ? $" · {Format.Duration(dur)}" : "")</span>
                @if (best) { <span class="small block good-text">@L["requests.bestMatch"]</span> }
            </span>
            <span class="row-actions">
                @if (score is { } sc) { <span class="badge @ScoreClass(sc)" title="@L["requests.scoreHint"]">@L["requests.score", ("score", sc)]</span> }
                @if (!known) { <PreviewButton VideoId="@v.VideoId" DurationSeconds="v.DurationSeconds" /> }
                <a class="icon-btn" href="https://www.youtube.com/watch?v=@v.VideoId" target="_blank" rel="noopener noreferrer" title="@L["yt.explore.open"]"><Icon Name="open" Size="18" /></a>
                @if (known)
                {
                    <span class="badge good">@L["requests.onServer"]</span>
                }
                else if (asked)
                {
                    <span class="badge info">@L["requests.asked"]</span>
                }
                else
                {
                    <button class="btn compact primary" disabled="@(_sending is not null)" @onclick="() => AskAsync(v)"><Icon Name="add" Size="16" /> @L["requests.ask"]</button>
                }
            </span>
        </li>
    };

    private static string ScoreClass(int score) => score >= 80 ? "good" : score >= 50 ? "warn" : "bad";

    private async Task MatchAsync()
    {
        if (string.IsNullOrWhiteSpace(_artist) || string.IsNullOrWhiteSpace(_title)) return;
        _searching = true;
        _match = null;
        await RunAsync(async () => _match = await Api.RequestMatchAsync(_artist.Trim(), _title.Trim(), _duration));
        _searching = false;
    }

    // Artiste et titre tapés à la main : pas de durée connue.
    private Task TypedMatchAsync()
    {
        _duration = null;
        _fromCatalog = false;
        return MatchAsync();
    }

    private async Task CatalogAsync()
    {
        if (string.IsNullOrWhiteSpace(_catalogQuery)) return;
        _searching = true;
        _catalog = null;
        _discography = null;
        await RunAsync(async () => _catalog = await Api.CatalogSearchAsync(_catalogQuery.Trim()));
        _searching = false;
    }

    /// <summary>Un titre du catalogue : recherche par correspondance, avec la durée du catalogue.</summary>
    private Task FindAsync(CatalogTrackDto track)
    {
        _mode = Mode.Match;
        _fromCatalog = true;
        _artist = track.Artist;
        _title = track.Title;
        _duration = track.DurationSeconds;
        return MatchAsync();
    }

    private async Task DiscographyAsync(CatalogArtistDto artist)
    {
        _discography = (artist, null);
        _revealHead = true;
        await RunAsync(async () => _discography = (artist, await Api.CatalogArtistAlbumsAsync(artist.Id, artist.Name) ?? []));
        _revealHead = true;
    }

    private async Task AskAlbumAsync(CatalogAlbumDto album)
    {
        _sending = $"album-{album.Id}";
        await RunAsync(async () =>
        {
            await Api.RequestAlbumAsync(new CreateAlbumRequest(album.Artist, album.Title));
            _albumsAsked.Add(album.Id);
            Ui.Notify(L["discover.albumSent", ("album", album.Title)]);
        });
        _sending = null;
    }

    private RenderFragment AlbumRow(CatalogAlbumDto a) => __builder =>
    {
        var details = new List<string> { a.Artist };
        if (a.Type is { } type && type != "album") details.Add(L[$"requests.catalogType.{type}"]);
        if (a.Year is { } year) details.Add(year);
        if (a.TrackCount is { } n) details.Add(L["requests.catalogTrackCount", ("count", n)]);
        <li @key="a.Id" class="@(a.InLibrary ? "known" : null)">
            @Cover(a.CoverUrl, "album")
            <span class="grow">
                <span class="strong">@a.Title</span>
                <span class="muted small block">@string.Join(" · ", details)</span>
            </span>
            <span class="row-actions">
                @if (a.InLibrary)
                {
                    <span class="badge good">@L["requests.onServer"]</span>
                }
                else if (_albumsAsked.Contains(a.Id))
                {
                    <span class="badge info">@L["requests.asked"]</span>
                }
                else
                {
                    <button class="btn compact primary" disabled="@(_sending is not null)" @onclick="() => AskAlbumAsync(a)"><Icon Name="album" Size="16" /> @L["requests.catalogAlbum"]</button>
                }
            </span>
        </li>
    };

    private static string TypeOf(CatalogAlbumDto a) => string.IsNullOrWhiteSpace(a.Type) ? "other" : a.Type;

    // Tous les types de Deezer, même absents de cette discographie, puis ceux qu'il ajouterait.
    private static IEnumerable<string> TypesOf(IEnumerable<CatalogAlbumDto> albums) =>
        KnownTypes.Concat(albums.Select(TypeOf).Distinct().Except(KnownTypes).Order());

    private string TypeLabel(string type) => KnownTypes.Contains(type) ? L[$"requests.catalogType.{type}"] : type == "other" ? L["requests.catalogType.other"] : type;

    private RenderFragment Filter(string label, int count, HashSet<string> hidden, string key) => __builder =>
    {
        <label class="check-pill @(count == 0 ? "empty" : null)">
            <input type="checkbox" checked="@(!hidden.Contains(key))" @onchange="() => { if (!hidden.Remove(key)) hidden.Add(key); }" />
            <span>@label</span>
            <span class="muted small">@count</span>
        </label>
    };

    private static RenderFragment Cover(string? url, string icon, bool round = false) => __builder =>
    {
        if (url is null)
        {
            <span class="catalog-cover placeholder @(round ? "round" : null)"><Icon Name="@icon" Size="22" /></span>
        }
        else
        {
            <img class="catalog-cover @(round ? "round" : null)" src="@url" alt="" loading="lazy" />
        }
    };

    private async Task AskAsync(YoutubeVideoDto video)
    {
        _sending = video.VideoId;
        await RunAsync(async () =>
        {
            // Résultats YouTube Music sans chaîne : en recherche par correspondance, l'artiste demandé la remplace.
            var channel = video.Channel ?? (_mode == Mode.Match && !string.IsNullOrWhiteSpace(_artist) ? _artist.Trim() : null);
            if (await Api.CreateRequestAsync(new CreateDownloadRequest(video.VideoId, video.Title, channel, video.DurationSeconds, null)) is { } created)
            {
                _asked.Add(video.VideoId);
                _mine.Insert(0, created);
                _total++;
                Ui.Notify(created.AutoApproved ? L["requests.sentAuto"] : L["requests.sent"]);
                _quota = await Api.RequestQuotaAsync();
            }
        });
        _sending = null;
    }

    private async Task MoreAsync()
    {
        await RunAsync(async () =>
        {
            var page = await Api.MyRequestsAsync(_mine.Count, Page);
            if (page is not null) { Paging.AppendNew(_mine, page.Items, r => r.Id); _total = page.Total; }
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }
}
