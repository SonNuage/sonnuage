@page "/discover"
@inject ApiClient Api
@inject AuthSession Auth
@inject UiState Ui

<PageTitle>@L["discover.title"] · SonNuage</PageTitle>

<div class="page">
    <header class="page-header">
        <h1>@L["discover.title"]</h1>
        @if (Auth.CanRequest)
        {
            <div class="row">
                <a class="btn" href="requests"><Icon Name="inbox" Size="18" /> @L["requests.title"]</a>
                @if (Auth.IsAdmin)
                {
                    <button class="btn" disabled="@(_page?.Refreshing == true || _refreshing)" @onclick="RefreshAsync"><Icon Name="refresh" Size="18" /> @L["discover.refresh"]</button>
                    <button class="btn" disabled="@_refreshingReleases" @onclick="RefreshReleasesAsync"><Icon Name="refresh" Size="18" /> @L["releases.refresh"]</button>
                }
            </div>
        }
    </header>
    <RadioRow ShowHint="true" />

    <section id="releases">
        <h2>@L["releases.title"]</h2>
        <p class="muted small">@(Auth.CanRequest ? L["releases.hint"] : L["releases.hintUser"])</p>
        <div class="tabs sub release-filters">
            @foreach (var (when, label) in Windows)
            {
                <button class="tab @(_when == when ? "active" : null)" @onclick="() => FilterAsync(when, _type)">@L[label]</button>
            }
            @foreach (var (type, label) in Types)
            {
                <button class="tab @(_type == type ? "active" : null)" @onclick="() => FilterAsync(_when, type)">@L[label]</button>
            }
        </div>
        @if (_releases is null)
        {
            <div class="empty"><Logo Size="16" Animated="true" /></div>
        }
        else if (_releases.Count == 0)
        {
            <div class="empty"><p>@L["releases.none"]</p></div>
        }
        else
        {
            <ReleaseRow Releases="_releases" />
        }
    </section>

    <h2 class="discover-section">@L["discover.artistsTitle"]</h2>
    @if (!Auth.CanRequest)
    {
        <div class="empty"><p>@L["discover.restricted"]</p></div>
    }
    else if (_page is null)
    {
        <div class="empty"><Logo Size="16" Animated="true" /></div>
    }
    else
    {
        <p class="muted small">
            @L["discover.hint"]
            @if (_page.UpdatedAt is { } updated) { <span>&#32;@L["discover.updated", ("date", L.Date(updated))]</span> }
            @if (_page.Refreshing) { <span>&#32;· <Logo Size="12" Animated="true" /> @L["discover.refreshing"]</span> }
        </p>
        @if (_page.Artists.Count == 0)
        {
            <div class="empty"><p>@(_page.Refreshing ? L["discover.firstRun"] : L["discover.none"])</p></div>
        }
        @foreach (var artist in _page.Artists)
        {
            <section class="discover-artist" @key="artist.Id">
                <header class="discover-artist-head">
                    <h2>@artist.Name</h2>
                    @if (DateTimeOffset.UtcNow - artist.AddedAt < TimeSpan.FromDays(1)) { <span class="badge good">@L["discover.new"]</span> }
                    @if (artist.Comment is { } comment) { <span class="muted small">@comment</span> }
                </header>
                @if (artist.BecauseOf.Count > 0)
                {
                    <p class="muted small discover-because">@L["discover.because", ("artists", string.Join(", ", artist.BecauseOf))]</p>
                }
                <div class="disc-row">
                    @foreach (var t in TracksOf(artist))
                    {
                        var known = t.ImportStatus is not null and not "Failed" and not "Skipped";
                        <article @key="t.Id" class="disc-card @(known ? "known" : null)">
                            <div class="disc-thumb">
                                @if (t.ThumbnailUrl is { } thumb)
                                {
                                    <img src="@thumb" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="disc-placeholder"><Icon Name="album" Size="40" /></span>
                                }
                                @if (t.VideoId is { } previewId && !known)
                                {
                                    <PreviewButton VideoId="@previewId" DurationSeconds="t.DurationSeconds" Overlay="true" />
                                }
                                @if (t.DurationSeconds is { } d) { <span class="disc-dur">@Format.Duration(d)</span> }
                                @if (known) { <span class="badge good disc-badge">@L["requests.onServer"]</span> }
                            </div>
                            <div class="disc-body">
                                <span class="disc-title" title="@t.Title">@t.Title</span>
                                <span class="muted small disc-sub">@(t.VideoId is null ? L["discover.notFound"] : t.ReleaseName ?? t.Channel ?? "")</span>
                            </div>
                            <div class="disc-actions">
                                @if (t.VideoId is { } videoId)
                                {
                                    @if (known)
                                    {
                                        <span class="btn compact disc-state"><Icon Name="library" Size="16" /> @L["requests.onServer"]</span>
                                    }
                                    else if (_asked.Contains(videoId))
                                    {
                                        <span class="btn compact disc-state"><Icon Name="inbox" Size="16" /> @L["requests.asked"]</span>
                                    }
                                    else
                                    {
                                        <button class="btn compact primary" disabled="@(_sending is not null)" @onclick="() => AskAsync(artist, t)"><Icon Name="add" Size="16" /> @L["requests.ask"]</button>
                                    }
                                }
                                else
                                {
                                    <a class="btn compact" href="@MatchLink(artist.Name, t.Title)"><Icon Name="search" Size="16" /> @L["discover.search"]</a>
                                }
                                @if (t.ReleaseName is { } album)
                                {
                                    var albumAsked = _albums.Contains(AlbumKey(artist.Name, album));
                                    <button class="btn compact disc-album @(albumAsked ? "on" : null)" disabled="@(albumAsked || _sendingAlbum)"
                                            title="@(albumAsked ? L["discover.albumAsked"] : L["discover.albumHint", ("album", album)])"
                                            @onclick="() => AskAlbumAsync(artist.Name, album)"><Icon Name="album" Size="16" /> @L["discover.album"]</button>
                                }
                                @if (t.VideoId is { } openId)
                                {
                                    <a class="icon-btn" href="https://www.youtube.com/watch?v=@openId" target="_blank" rel="noopener noreferrer"
                                       title="@L["yt.explore.open"]" aria-label="@L["yt.explore.open"]"><Icon Name="open" Size="18" /></a>
                                }
                            </div>
                        </article>
                    }
                </div>
                @if (RemainingOf(artist) is > 0 and var remaining)
                {
                    <div class="row discover-more">
                        @if (_loadingMore == artist.Id)
                        {
                            <span class="muted small"><Logo Size="14" Animated="true" /> @L["discover.moreLoading"]</span>
                        }
                        else
                        {
                            <button class="btn compact" disabled="@(_loadingMore is not null)" title="@L["discover.moreHint"]"
                                    @onclick="() => MoreAsync(artist, all: false)"><Icon Name="add" Size="16" /> @L["discover.more"]</button>
                            @if (remaining > MoreStep)
                            {
                                <button class="btn compact" disabled="@(_loadingMore is not null)" title="@L["discover.moreHint"]"
                                        @onclick="() => MoreAsync(artist, all: true)">@L["discover.all", ("count", remaining)]</button>
                            }
                        }
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    private DiscoveryPageDto? _page;
    private readonly HashSet<string> _asked = [];
    private string? _sending;
    private bool _refreshing;

    private List<ArtistReleaseDto>? _releases;
    private string? _when;
    private string? _type;
    private bool _refreshingReleases;

    // Un utilisateur simple ne voit que ce qui est déjà sur le serveur : rien « à venir ».
    private IEnumerable<(string? When, string Label)> Windows => Auth.CanRequest
        ? [(null, "releases.all"), ("recent", "releases.recent"), ("upcoming", "releases.upcomingFilter")]
        : [];

    private static readonly (string? Type, string Label)[] Types =
        [(null, "releases.allTypes"), ("album", "releases.type.album"), ("ep", "releases.type.ep"), ("single", "releases.type.single")];

    protected override async Task OnInitializedAsync()
    {
        await LoadReleasesAsync();
        if (!Auth.CanRequest) return;
        await RunAsync(async () => _page = await Api.DiscoveryAsync());
    }

    private async Task LoadReleasesAsync() => await RunAsync(async () => _releases = await Api.ReleasesAsync(_when, _type) ?? []);

    private async Task FilterAsync(string? when, string? type)
    {
        (_when, _type) = (when, type);
        _releases = null;
        await LoadReleasesAsync();
    }

    private async Task RefreshReleasesAsync()
    {
        _refreshingReleases = true;
        await RunAsync(async () =>
        {
            await Api.RefreshReleasesAsync();
            Ui.Notify(L["releases.refreshStarted"]);
        });
        _refreshingReleases = false;
    }

    /// <summary>Titres ajoutés par « voir plus » : le serveur les cherche sur YouTube à la demande, par petits lots.</summary>
    private const int MoreStep = 3;
    private readonly Dictionary<Guid, List<DiscoveryTrackDto>> _more = [];
    private readonly Dictionary<Guid, int> _remaining = [];
    private Guid? _loadingMore;

    private IEnumerable<DiscoveryTrackDto> TracksOf(DiscoveryArtistDto artist) =>
        _more.TryGetValue(artist.Id, out var more) ? artist.Tracks.Concat(more) : artist.Tracks;

    private int RemainingOf(DiscoveryArtistDto artist) => _remaining.TryGetValue(artist.Id, out var left) ? left : artist.MoreTracks;

    /// <summary>Les titres suivants de l'artiste ; « tout » : lot après lot, chacun affiché dès qu'il arrive.</summary>
    private async Task MoreAsync(DiscoveryArtistDto artist, bool all)
    {
        _loadingMore = artist.Id;
        await RunAsync(async () =>
        {
            do
            {
                var shown = TracksOf(artist).Count();
                if (await Api.DiscoveryMoreAsync(artist.Id, shown, MoreStep) is not { Tracks.Count: > 0 } next)
                {
                    _remaining[artist.Id] = 0;
                    break;
                }
                if (!_more.TryGetValue(artist.Id, out var more)) _more[artist.Id] = more = [];
                more.AddRange(next.Tracks);
                _remaining[artist.Id] = next.Remaining;
                StateHasChanged();
            } while (all && RemainingOf(artist) > 0);
        });
        _loadingMore = null;
    }

    private static string MatchLink(string artist, string title) =>
        $"requests?artist={Uri.EscapeDataString(artist)}&title={Uri.EscapeDataString(title)}";

    private readonly HashSet<string> _albums = [];
    private bool _sendingAlbum;

    private static string AlbumKey(string artist, string album) => $"{artist}\n{album}".ToLowerInvariant();

    /// <summary>Tout l'album : le serveur retrouve ses titres et les demande un par un, en tâche de fond.</summary>
    private async Task AskAlbumAsync(string artist, string album)
    {
        _sendingAlbum = true;
        await RunAsync(async () =>
        {
            await Api.RequestAlbumAsync(new CreateAlbumRequest(artist, album));
            _albums.Add(AlbumKey(artist, album));
            Ui.Notify(L["discover.albumSent", ("album", album)]);
        });
        _sendingAlbum = false;
    }

    private async Task AskAsync(DiscoveryArtistDto artist, DiscoveryTrackDto track)
    {
        _sending = track.VideoId;
        await RunAsync(async () =>
        {
            var title = track.VideoTitle ?? $"{artist.Name} - {track.Title}";
            // L'artiste plutôt que la chaîne (souvent une chaîne de paroles) : c'est ce que l'admin doit voir.
            if (await Api.CreateRequestAsync(new CreateDownloadRequest(track.VideoId!, title, artist.Name, track.DurationSeconds, null)) is { } created)
            {
                _asked.Add(track.VideoId!);
                Ui.Notify(created.AutoApproved ? L["requests.sentAuto"] : L["requests.sent"]);
            }
        });
        _sending = null;
    }

    private async Task RefreshAsync()
    {
        _refreshing = true;
        await RunAsync(async () =>
        {
            await Api.RefreshDiscoveryAsync();
            Ui.Notify(L["discover.refreshStarted"]);
            _page = await Api.DiscoveryAsync();
        });
        _refreshing = false;
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }
}
