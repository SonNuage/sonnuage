@page "/admin/library"
@inject ApiClient Api
@inject UiState Ui
@inject NavigationManager Nav

<PageTitle>@L["admin.tabs.metadata"] · SonNuage</PageTitle>

<div class="page">
    <AdminNav Title="@L["admin.nav.metadata"]">
        @if (_album is { } album)
        {
            <section class="panel album-editor">
                <Cover AlbumId="album.Album.Id" HasCover="album.Album.HasCover" Size="300" Class="cover-md" Seed="@album.Album.Title" />
                <form class="stack" @onsubmit="SaveAlbumAsync" @onsubmit:preventDefault="true">
                    <h2>@L["editor.album"]</h2>
                    <div class="form-grid">
                        <label class="field"><span>@L["editor.title"]</span><input class="input" @bind="_albumTitle" required /></label>
                        <label class="field"><span>@L["editor.albumArtist"]</span><input class="input" @bind="_albumArtist" required /></label>
                        <label class="field"><span>@L["editor.year"]</span><input class="input" type="number" @bind="_albumYear" /></label>
                    </div>
                    <div class="row">
                        <button class="btn primary" type="submit">@L["editor.saveAlbum"]</button>
                        <label class="btn">
                            @L["editor.changeCover"]
                            <InputFile OnChange="UploadCoverAsync" accept="image/jpeg,image/png,image/webp" class="hidden-input" />
                        </label>
                        <a class="btn" href="album/@album.Album.Id">@L["track.goToAlbum"]</a>
                    </div>
                    <p class="muted small">@L["editor.dbOnly"]</p>
                </form>
            </section>
        }

        <div class="toolbar">
            <input class="input" type="search" placeholder="@L["editor.searchPlaceholder"]" @bind="_query" @bind:event="oninput" @bind:after="SearchAsync" />
            @if (AlbumId is not null)
            {
                <button class="btn" @onclick='() => Nav.NavigateTo("admin/library")'>@L["editor.wholeLibrary"]</button>
            }
        </div>

        <Loader Loading="_loading && _tracks.Count == 0" Error="@_error" OnRetry="SearchAsync">
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr><th>#</th><th>@L["editor.title"]</th><th>@L["editor.artist"]</th><th>@L["editor.album"]</th><th>@L["editor.file"]</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _tracks)
                        {
                            <tr @key="t.Id">
                                <td>@(t.DiscNumber is > 1 ? $"{t.DiscNumber}-" : "")@t.TrackNumber</td>
                                <td>@t.Title @if (t.MetadataLocked) { <span class="badge" title="@L["editor.editedHint"]">@L["editor.edited"]</span> }</td>
                                <td>@t.ArtistName</td>
                                <td>@t.AlbumTitle</td>
                                <td class="path" title="@t.RelativePath">@t.RelativePath</td>
                                <td class="row-actions">
                                    <button class="icon-btn" title="@L["common.edit"]" @onclick="() => Edit(t)"><Icon Name="edit" Size="18" /></button>
                                    @if (t.Deletable)
                                    {
                                        <button class="icon-btn danger" title="@L["common.delete"]" @onclick="() => _deleting = t"><Icon Name="delete" Size="18" /></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted small">@L["editor.count", ("shown", _tracks.Count), ("total", _total)]</p>
            @if (_tracks.Count < _total)
            {
                <div class="more"><button class="btn" @onclick="LoadMoreAsync" disabled="@_loading">@L["common.showMore"]</button></div>
            }
        </Loader>
    </AdminNav>
</div>

<Modal Open="_editing is not null" OpenChanged="v => { if (!v) _editing = null; }" Title="@L["editor.editTrack"]">
    <ChildContent>
        @if (_editing is not null)
        {
            <form id="track-form" class="form-grid" @onsubmit="SaveTrackAsync" @onsubmit:preventDefault="true">
                <label class="field wide"><span>@L["editor.title"]</span><input class="input" @bind="_form.Title" required /></label>
                <label class="field"><span>@L["editor.artist"]</span><input class="input" @bind="_form.Artist" required /></label>
                <label class="field"><span>@L["editor.albumArtist"]</span><input class="input" @bind="_form.AlbumArtist" required /></label>
                <label class="field wide"><span>@L["editor.album"]</span><input class="input" @bind="_form.Album" required /></label>
                <label class="field"><span>@L["editor.trackNumber"]</span><input class="input" type="number" @bind="_form.Track" /></label>
                <label class="field"><span>@L["editor.discNumber"]</span><input class="input" type="number" @bind="_form.Disc" /></label>
                <label class="field"><span>@L["editor.year"]</span><input class="input" type="number" @bind="_form.Year" /></label>
                <label class="field"><span>@L["editor.genre"]</span><input class="input" @bind="_form.Genre" /></label>
                <p class="muted small wide">@L["editor.fileIs", ("path", _editing.RelativePath)]</p>
            </form>
        }
    </ChildContent>
    <Footer>
        <button class="btn" @onclick="() => _editing = null">@L["common.cancel"]</button>
        <button class="btn primary" type="submit" form="track-form">@L["common.save"]</button>
    </Footer>
</Modal>

<Modal Open="_deleting is not null" OpenChanged="v => { if (!v) _deleting = null; }" Title="@L["editor.deleteConfirm"]">
    <ChildContent><p>@L["editor.deleteHint", ("title", _deleting?.Title)]</p></ChildContent>
    <Footer>
        <button class="btn" @onclick="() => _deleting = null">@L["common.cancel"]</button>
        <button class="btn danger" @onclick="DeleteAsync">@L["common.delete"]</button>
    </Footer>
</Modal>

@code {
    private const int PageSize = 100;
    [SupplyParameterFromQuery(Name = "album")] public Guid? AlbumId { get; set; }

    private readonly List<TrackMetadataDto> _tracks = [];
    private int _total;
    private string _query = "";
    private bool _loading;
    private string? _error;
    private AlbumDetailDto? _album;
    private string _albumTitle = "";
    private string _albumArtist = "";
    private int? _albumYear;
    private TrackMetadataDto? _editing;
    private TrackMetadataDto? _deleting;
    private TrackForm _form = new();
    private Guid? _loadedAlbum = Guid.Empty;

    private sealed class TrackForm
    {
        public string Title { get; set; } = "";
        public string Artist { get; set; } = "";
        public string AlbumArtist { get; set; } = "";
        public string Album { get; set; } = "";
        public int? Track { get; set; }
        public int? Disc { get; set; }
        public int? Year { get; set; }
        public string? Genre { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedAlbum == AlbumId) return;
        _loadedAlbum = AlbumId;
        await LoadAlbumAsync();
        await SearchAsync();
    }

    private async Task LoadAlbumAsync()
    {
        _album = AlbumId is { } id ? await Api.AlbumAsync(id) : null;
        if (_album is not null)
        {
            _albumTitle = _album.Album.Title;
            _albumArtist = _album.Album.ArtistName;
            _albumYear = _album.Album.Year;
        }
    }

    private async Task SearchAsync()
    {
        _tracks.Clear();
        _total = 0;
        await LoadMoreAsync();
    }

    private async Task LoadMoreAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var page = await Api.AdminTracksAsync(_query, AlbumId, _tracks.Count, PageSize);
            if (page is not null)
            {
                _tracks.AddRange(page.Items);
                _total = page.Total;
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = L.Server(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void Edit(TrackMetadataDto t)
    {
        _editing = t;
        _form = new TrackForm
        {
            Title = t.Title, Artist = t.ArtistName, AlbumArtist = t.AlbumArtistName, Album = t.AlbumTitle,
            Track = t.TrackNumber, Disc = t.DiscNumber, Year = t.Year, Genre = t.Genre,
        };
    }

    private async Task SaveTrackAsync()
    {
        if (_editing is null) return;
        try
        {
            var updated = await Api.AdminUpdateTrackAsync(_editing.Id, new UpdateTrackMetadataRequest(
                _form.Title, _form.Artist, _form.Album, _form.AlbumArtist, _form.Track, _form.Disc, _form.Year, _form.Genre));
            var i = _tracks.FindIndex(x => x.Id == _editing.Id);
            if (updated is not null && i >= 0) _tracks[i] = updated;
            _editing = null;
            Ui.Notify(L["editor.trackUpdated"]);
        }
        catch (ApiException ex)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }

    private async Task SaveAlbumAsync()
    {
        if (_album is null) return;
        try
        {
            var updated = await Api.AdminUpdateAlbumAsync(_album.Album.Id, new UpdateAlbumRequest(_albumTitle, _albumArtist, _albumYear));
            Ui.Notify(L["editor.albumUpdated"]);
            // Changer l'artiste ou le titre peut fusionner l'album avec un existant : l'id change.
            if (updated is not null && updated.Id != _album.Album.Id) Nav.NavigateTo($"admin/library?album={updated.Id}");
            else
            {
                await LoadAlbumAsync();
                await SearchAsync();
            }
        }
        catch (ApiException ex)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }

    private async Task UploadCoverAsync(InputFileChangeEventArgs e)
    {
        if (_album is null) return;
        try
        {
            await using var stream = e.File.OpenReadStream(10 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;
            await Api.AdminSetAlbumCoverAsync(_album.Album.Id, buffer, e.File.ContentType);
            Ui.Notify(L["editor.coverUpdated"]);
            await LoadAlbumAsync();
        }
        catch (Exception ex) when (ex is ApiException or IOException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }

    private async Task DeleteAsync()
    {
        if (_deleting is null) return;
        try
        {
            await Api.AdminDeleteTrackAsync(_deleting.Id);
            _tracks.RemoveAll(t => t.Id == _deleting.Id);
            _total--;
            Ui.Notify(L["editor.fileDeleted"]);
        }
        catch (ApiException ex)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
        _deleting = null;
    }
}
