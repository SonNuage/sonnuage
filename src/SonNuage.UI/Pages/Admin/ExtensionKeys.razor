@* Clés d'API de l'extension de navigateur (bouton « Ajouter à SonNuage » sur YouTube). *@
@inject ApiClient Api
@inject UiState Ui
@inject IServerEndpoint Endpoint

<section class="panel">
    <h2>@L["keys.title"]</h2>
    <p class="muted small">
        @L["keys.intro"]
    </p>
    @if (Endpoint.BaseAddress is { } server)
    {
        <label class="field">
            <span>@L["keys.serverUrl"]</span>
            <input class="input mono" readonly value="@server.ToString().TrimEnd('/')" onfocus="this.select()" />
        </label>
    }
    <form class="inline-form" @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
        <input class="input" placeholder="@L["keys.namePlaceholder"]" @bind="_name" maxlength="100" autocomplete="off" required />
        <button class="btn primary" type="submit">@L["keys.create"]</button>
    </form>

    @if (_created is { } created)
    {
        <div class="notice" style="margin-top: .6rem">
            <span>@L["keys.created", ("name", created.Key.Name)]</span>
            <input class="input mono" readonly value="@created.Secret" onfocus="this.select()" />
            <button class="btn" @onclick="() => _created = null">@L["common.close"]</button>
        </div>
    }

    @if (_keys is { Count: > 0 })
    {
        <div class="table-wrap" style="margin-top: .6rem">
            <table class="table">
                <thead><tr><th>@L["keys.colName"]</th><th>@L["keys.colKey"]</th><th>@L["keys.colCreated"]</th><th>@L["keys.colLastUsed"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var k in _keys)
                    {
                        <tr @key="k.Id">
                            <td>@k.Name</td>
                            <td class="mono">@k.Prefix…</td>
                            <td>@L.Date(k.CreatedAt) <span class="muted small">@L["keys.by", ("name", k.CreatedBy)]</span></td>
                            <td>@(k.LastUsedAt is { } used ? L.DateTime(used) : L["common.never"])</td>
                            <td class="row-actions">
                                <button class="icon-btn danger" title="@L["keys.revoke"]" @onclick="() => _revoking = k"><Icon Name="delete" Size="18" /></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_keys is not null)
    {
        <p class="muted small">@L["keys.none"]</p>
    }
</section>

<Modal Open="_revoking is not null" OpenChanged="v => { if (!v) _revoking = null; }" Title="@L["keys.revokeConfirm"]">
    <ChildContent><p>@L["keys.revokeHint", ("name", _revoking?.Name)]</p></ChildContent>
    <Footer>
        <button class="btn" @onclick="() => _revoking = null">@L["common.cancel"]</button>
        <button class="btn danger" @onclick="RevokeAsync">@L["keys.revoke"]</button>
    </Footer>
</Modal>

@code {
    private List<ExtensionKeyDto>? _keys;
    private string _name = "";
    private CreatedExtensionKeyDto? _created;
    private ExtensionKeyDto? _revoking;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _keys = await Api.ExtensionKeysAsync() ?? [];
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        try
        {
            _created = await Api.CreateExtensionKeyAsync(_name.Trim());
            _name = "";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }

    private async Task RevokeAsync()
    {
        if (_revoking is not { } key) return;
        _revoking = null;
        try
        {
            await Api.RevokeExtensionKeyAsync(key.Id);
            Ui.Notify(L["keys.revoked"]);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }
}
