@page "/admin/youtube"
@page "/admin/imports"
@page "/admin/subscriptions"
@page "/admin/settings"
@using System.Globalization
@implements IDisposable
@inject ApiClient Api
@inject UiState Ui
@inject NavigationManager Nav

<PageTitle>@TabTitle · SonNuage</PageTitle>

<div class="page">
    <AdminNav Title="@TabTitle">
        @if (_status is { } st)
        {
            @if (st.Tools.YtDlp is null)
            {
                <div class="notice warn">
                    <span>@L["yt.notInstalled"]</span>
                    <button class="btn primary" disabled="@_updating" @onclick="() => UpdateToolsAsync(true)">@(_updating ? L["yt.installing"] : L["yt.install"])</button>
                </div>
            }
            @if (st.HoldUntil is { } until && until > DateTimeOffset.Now)
            {
                <div class="notice warn">
                    <span>@L["yt.hold", ("time", until.ToLocalTime().ToString("HH:mm"))]
                        @if (!st.HasCookies) { <span>@L["yt.holdCookies"]</span> }
                        <span class="muted small">@L.Server(st.HoldReason ?? "")</span></span>
                    <button class="btn" @onclick="ResumeAsync">@L["yt.resumeNow"]</button>
                </div>
            }
            @foreach (var cur in _tab == "queue" ? st.Active : [])
            {
                <div class="notice" @key="cur.ItemId">
                    <Logo Size="16" Animated="true" />
                    <span class="grow"><span class="strong">@cur.Title</span> - @StageLabel(cur.Stage)@(cur.Percent is { } p ? " " + L["format.percent", ("value", L.Number(p))] : "")</span>
                    @if (cur.Percent is { } pc) { <progress max="100" value="@pc.ToString(CultureInfo.InvariantCulture)"></progress> }
                </div>
            }
        }

        @switch (_tab)
        {
            case "explore":
                @Explore
                break;
            case "queue":
                @Queue
                break;
            case "subs":
                @Subscriptions
                break;
            default:
                @Settings
                break;
        }
    </AdminNav>
</div>

<Modal Open="_formatsItem is not null" OpenChanged="v => { if (!v) _formatsItem = null; }" Title="@L["yt.formats.title"]">
    <ChildContent>
        @if (_formatsItem is { } fi)
        {
            <p class="strong">@fi.Title</p>
            <p class="muted small">@L["yt.formats.hint"]</p>
            <pre class="formats-table">@(_formats is { } formats ? L.Server(formats) : L["yt.formats.none"])</pre>
            <div class="row">
                <input class="input mono grow" placeholder="@L["yt.formats.placeholder"]" @bind="_format" @bind:event="oninput" aria-label="@L["yt.formats.aria"]" />
                <button class="btn primary" disabled="@string.IsNullOrWhiteSpace(_format)" @onclick="RetryWithFormatAsync">@L["yt.formats.retry"]</button>
            </div>
        }
    </ChildContent>
</Modal>

<Modal Open="_review is not null" OpenChanged="v => { if (!v) _review = null; }" Title="@L["yt.review.title"]">
    <ChildContent>
        @if (_review is { } r)
        {
            <div class="review-head">
                <img class="cover-sm" src="@r.Item.ThumbnailUrl" alt="" loading="lazy" />
                <div class="grow">
                    <div class="strong">@r.Item.Title</div>
                    <div class="muted small">@r.Item.Channel · @Format.Duration(r.Item.DurationSeconds ?? 0) · <a href="https://www.youtube.com/watch?v=@r.Item.VideoId" target="_blank" rel="noopener noreferrer">@L["yt.review.watch"]</a></div>
                </div>
            </div>
            <h3 class="small muted">@L["yt.review.candidates"]</h3>
            <ul class="candidates">
                @foreach (var c in r.Candidates)
                {
                    <li class="@(ReferenceEquals(c, r.Selected) ? "on" : null)" @onclick="() => Select(r, c)">
                        <span class="score @(c.Score >= 0.8 ? "good" : c.Score >= 0.5 ? "mid" : "low")">@((c.Score * 100).ToString("0"))</span>
                        <span class="grow">
                            <span class="strong">@c.Title</span> - @c.Artist
                            <span class="muted small block">@c.Album@(c.Year is { } y ? $" ({y})" : "")@(c.TrackNumber is { } n ? " · " + L["yt.review.trackNo", ("number", n)] : "") · @SourceLabel(c.Source)</span>
                        </span>
                    </li>
                }
            </ul>
            <form class="inline-form" @onsubmit="() => SearchMusicBrainzAsync(r)" @onsubmit:preventDefault="true">
                <input class="input" placeholder="@L["editor.title"]" @bind="r.SearchTitle" />
                <input class="input" placeholder="@L["editor.artist"]" @bind="r.SearchArtist" />
                <button class="btn" type="submit" disabled="@r.Searching"><Icon Name="search" Size="18" /> MusicBrainz</button>
            </form>
            <h3 class="small muted">@L["yt.review.applied"]</h3>
            <div class="form-grid">
                <label class="field"><span>@L["editor.title"]</span><input class="input" @bind="r.Edit.Title" /></label>
                <label class="field"><span>@L["editor.artist"]</span><input class="input" @bind="r.Edit.Artist" /></label>
                <label class="field"><span>@L["editor.album"]</span><input class="input" @bind="r.Edit.Album" /></label>
                <label class="field"><span>@L["editor.albumArtist"]</span><input class="input" @bind="r.Edit.AlbumArtist" /></label>
                <label class="field"><span>@L["yt.review.track"]</span><input class="input" type="number" min="1" @bind="r.Edit.TrackNumber" /></label>
                <label class="field"><span>@L["editor.year"]</span><input class="input" type="number" @bind="r.Edit.Year" /></label>
                <label class="field"><span>@L["editor.genre"]</span><input class="input" @bind="r.Edit.Genre" /></label>
            </div>
        }
    </ChildContent>
    <Footer>
        @if (_review is { } r)
        {
            <button class="btn" @onclick="() => AcceptAsync(r)">@L["yt.review.keep"]</button>
            <button class="btn primary" disabled="@r.Applying" @onclick="() => ApplyAsync(r)">@(r.Applying ? L["yt.review.applying"] : L["yt.review.apply"])</button>
        }
    </Footer>
</Modal>

@code {
    // Une adresse par entrée du menu d'administration.
    private static readonly Dictionary<string, (string Tab, string Title)> Routes = new()
    {
        ["admin/youtube"] = ("explore", "admin.nav.youtube"),
        ["admin/imports"] = ("queue", "admin.nav.imports"),
        ["admin/subscriptions"] = ("subs", "admin.nav.subscriptions"),
        ["admin/settings"] = ("settings", "admin.nav.settings"),
    };

    private string? _route;
    private string TabTitle => L[Routes.TryGetValue(_route ?? "", out var r) ? r.Title : "admin.nav.youtube"];

    // Les quatre adresses partagent ce composant : Blazor le garde d'une adresse à l'autre sans lui redonner de
    // paramètres, d'où l'écoute de la navigation en plus du premier affichage.
    protected override Task OnParametersSetAsync() => FollowRouteAsync();

    private async Task FollowRouteAsync()
    {
        var route = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
        if (route == _route || !Routes.TryGetValue(route, out var r)) return;
        _route = route;
        await SwitchAsync(r.Tab);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(async () =>
        {
            await FollowRouteAsync();
            StateHasChanged();
        });
    private static readonly (string? Status, bool Review, string Key)[] Filters =
        [(null, false, "all"), ("Queued", false, "queued"), (null, true, "review"), ("Failed", false, "failed"), ("Done", false, "done"), ("Skipped", false, "skipped")];

    private string _tab = "explore";
    private YoutubeStatusDto? _status;
    private Timer? _timer;
    private bool _updating;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await RefreshStatusAsync();
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            await RefreshStatusAsync();
            if (_tab == "queue" && _review is null) await LoadItemsAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
    }

    private async Task RefreshStatusAsync()
    {
        try
        {
            _status = await Api.YoutubeStatusAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
        }
    }

    private async Task SwitchAsync(string tab)
    {
        _tab = tab;
        if (tab == "queue") await LoadItemsAsync();
        else if (tab == "subs") await LoadSubscriptionsAsync();
        else if (tab == "settings") _settings ??= await Run(() => Api.YoutubeSettingsAsync());
    }

    private async Task<T?> Run<T>(Func<Task<T?>> action)
    {
        try
        {
            return await action();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
            return default;
        }
    }

    private async Task<bool> Run(Func<Task> action, string? success = null)
    {
        try
        {
            await action();
            if (success is not null) Ui.Notify(success);
            return true;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
            return false;
        }
    }

    private async Task ResumeAsync()
    {
        await Run(Api.YoutubeResumeAsync);
        await RefreshStatusAsync();
    }

    // ---------- Explorer ----------

    private string _query = "";
    private bool _music = true;
    private bool _searching;
    private bool _disposed;
    // Albums lus sur albums trouvés, pendant la lecture d'une chaîne.
    private (int Read, int Total)? _progress;
    private YoutubeListingDto? _listing;
    private HashSet<string> _selected = [];
    private string? _albumHint;
    private bool _isAlbum;

    private RenderFragment Explore => __builder =>
    {
        <section class="panel">
            <form class="inline-form" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                <input class="input" placeholder="@L["yt.explore.placeholder"]" @bind="_query" />
                <div class="segmented" role="group" aria-label="Source">
                    <button type="button" class="@(_music ? "on" : null)" @onclick="() => _music = true">YouTube Music</button>
                    <button type="button" class="@(!_music ? "on" : null)" @onclick="() => _music = false">YouTube</button>
                </div>
                <button class="btn primary" type="submit" disabled="@(_searching || string.IsNullOrWhiteSpace(_query))"><Icon Name="search" Size="18" /> @L["yt.explore.search"]</button>
            </form>
            <p class="muted small">@L["yt.explore.hint"]</p>
        </section>

        @if (_searching)
        {
            <div class="empty"><Logo Size="16" Animated="true" /> @(_progress is { Total: > 0 } p
                ? L["yt.explore.readingAlbums", ("read", p.Read), ("total", p.Total)]
                : L["yt.explore.searching"])</div>
        }
        else if (_listing is { } l)
        {
            <section class="panel">
                <div class="viz-head">
                    <div>
                        <h2>@l.Title</h2>
                        <span class="muted small">@L["common.videos", ("count", l.Entries.Count)]@(l.Channel is { } ch ? $" · {ch}" : "")</span>
                    </div>
                    <div class="row">
                        <button class="btn" @onclick="ToggleAll">@(_selected.Count == Importable(l).Count() ? L["yt.explore.deselectAll"] : L["yt.explore.selectAll"])</button>
                        <button class="btn primary" disabled="@(_selected.Count == 0)" @onclick="ImportAsync"><Icon Name="add" Size="18" /> @L["yt.explore.import", ("count", _selected.Count)]</button>
                    </div>
                </div>
                @if (l.Kind == "playlist" && l.Url.StartsWith("https://"))
                {
                    <div class="inline-form">
                        <label class="row small"><input type="checkbox" @bind="_isAlbum" /> @L["yt.explore.isAlbum"]</label>
                        @if (_isAlbum)
                        {
                            <input class="input" placeholder="@L["yt.explore.albumName"]" @bind="_albumHint" />
                        }
                        <button class="btn" @onclick="() => SubscribeAsync(l.Url, false)">@L["yt.explore.subscribeNew"]</button>
                        <button class="btn" @onclick="() => SubscribeAsync(l.Url, true)">@L["yt.explore.subscribeAll"]</button>
                    </div>
                }
                <ul class="yt-list">
                    @foreach (var v in l.Entries)
                    {
                        var known = v.ImportStatus is not null and not "Failed" and not "Skipped";
                        <li class="@(known ? "known" : null)">
                            <input type="checkbox" checked="@_selected.Contains(v.VideoId)" disabled="@known" @onchange="() => Toggle(v.VideoId)" aria-label="@L["yt.explore.select", ("title", v.Title)]" />
                            <img class="yt-thumb" src="@v.ThumbnailUrl" alt="" loading="lazy" />
                            <span class="grow">
                                <span class="strong">@v.Title</span>
                                <span class="muted small block">@v.Channel@(v.DurationSeconds is { } dur ? $" · {Format.Duration(dur)}" : "")</span>
                            </span>
                            @if (v.ImportStatus is { } status) { <span class="badge @StatusClass(status)">@StatusLabel(status)</span> }
                            <a class="icon-btn" href="https://www.youtube.com/watch?v=@v.VideoId" target="_blank" rel="noopener noreferrer" title="@L["yt.explore.open"]"><Icon Name="open" Size="18" /></a>
                        </li>
                    }
                </ul>
            </section>
        }
    };

    private static IEnumerable<YoutubeVideoDto> Importable(YoutubeListingDto l) => l.Entries.Where(v => v.ImportStatus is null or "Failed" or "Skipped");

    private async Task SearchAsync()
    {
        _searching = true;
        _listing = null;
        _selected = [];
        _progress = null;
        StateHasChanged();
        var q = _query.Trim();
        _listing = Uri.TryCreate(q, UriKind.Absolute, out _) ? await ReadListingAsync(q) : await Run(() => Api.YoutubeSearchAsync(q, _music));
        _albumHint = _listing?.Kind == "playlist" ? _listing.Title.Replace("Album - ", "") : null;
        _isAlbum = _listing?.Url.Contains("OLAK5uy_") == true; // albums YouTube Music
        _searching = false;
    }

    /// <summary>
    /// Playlist ou chaîne : le serveur la lit en arrière-plan (une grosse discographie prend plusieurs minutes,
    /// plus que ce qu'une requête tient derrière un proxy) et on suit l'avancement.
    /// </summary>
    private async Task<YoutubeListingDto?> ReadListingAsync(string url)
    {
        var task = await Run(() => Api.YoutubeStartListingAsync(url));
        while (task is { Done: false } && !_disposed)
        {
            _progress = (task.Read, task.Total);
            StateHasChanged();
            await Task.Delay(TimeSpan.FromSeconds(1));
            var id = task.Id;
            task = await Run(() => Api.YoutubeListingAsync(id));
        }
        if (task?.Error is { } error) Ui.Notify(L.Server(error), true);
        return task?.Listing;
    }

    private void Toggle(string id)
    {
        if (!_selected.Remove(id)) _selected.Add(id);
    }

    private void ToggleAll()
    {
        if (_listing is null) return;
        var all = Importable(_listing).Select(v => v.VideoId).ToHashSet();
        _selected = _selected.Count == all.Count ? [] : all;
    }

    private async Task ImportAsync()
    {
        if (_listing is null) return;
        var videos = _listing.Entries.Where(v => _selected.Contains(v.VideoId)).ToList();
        var result = await Run(() => Api.YoutubeImportAsync(new YoutubeImportRequest(videos, _isAlbum ? _albumHint : null)));
        if (result is null) return;
        Ui.Notify(result.AlreadyKnown > 0
            ? L["yt.explore.queuedKnown", ("queued", result.Queued), ("known", result.AlreadyKnown)]
            : L["yt.explore.queued", ("queued", result.Queued)]);
        _listing = _listing with { Entries = _listing.Entries.Select(v => _selected.Contains(v.VideoId) ? v with { ImportStatus = "Queued" } : v).ToList() };
        _selected = [];
        await RefreshStatusAsync();
    }

    private async Task SubscribeAsync(string url, bool importExisting)
    {
        if (await Run(() => Api.YoutubeSubscribeAsync(new CreateSubscriptionRequest(url, _isAlbum, importExisting)), L["yt.subs.created"]))
            await RefreshStatusAsync();
    }

    // ---------- File d'attente ----------

    private int _filter;
    private string? _itemQuery;
    private PagedResult<YoutubeItemDto>? _items;
    private int _limit = 50;

    private RenderFragment Queue => __builder =>
    {
        <div class="toolbar">
            <div class="segmented" role="group" aria-label="@L["yt.filterAria"]">
                @for (var i = 0; i < Filters.Length; i++)
                {
                    var index = i;
                    <button class="@(_filter == index ? "on" : null)" @onclick="() => SetFilterAsync(index)">@L["yt.filter." + Filters[i].Key]</button>
                }
            </div>
            <input class="input" placeholder="@L["yt.queue.filterPlaceholder"]" @bind="_itemQuery" @bind:event="oninput" @bind:after="LoadItemsAsync" />
            @if (_status?.Failed > 0)
            {
                <button class="btn" @onclick="RetryFailedAsync"><Icon Name="refresh" Size="18" /> @L["yt.queue.retryFailed"]</button>
            }
        </div>
        @if (_items is { } pg)
        {
            @if (pg.Items.Count == 0)
            {
                <div class="empty">@L["yt.queue.empty"]</div>
            }
            <ul class="yt-list">
                @foreach (var item in pg.Items)
                {
                    <li @key="item.Id">
                        <img class="yt-thumb" src="@item.ThumbnailUrl" alt="" loading="lazy" />
                        <span class="grow">
                            @if (item.TrackTitle is not null)
                            {
                                <span class="strong">@item.TrackTitle</span><span> - @item.TrackArtist</span>
                                <span class="muted small block">@item.TrackAlbum · @L["yt.queue.from", ("title", item.Title)]</span>
                            }
                            else
                            {
                                <span class="strong">@item.Title</span>
                                <span class="muted small block">@item.Channel@(item.SubscriptionTitle is { } sub ? " · " + L["yt.queue.subscription", ("name", sub)] : "")</span>
                            }
                            @if (item.Error is { } err && item.Status != "Done") { <span class="form-error small block">@L.Server(err)</span> }
                        </span>
                        @if (item.NeedsReview && item.Status == "Done")
                        {
                            <button class="badge warn clickable" @onclick="() => OpenReviewAsync(item)">@L["yt.queue.toReview"] @Confidence(item)</button>
                        }
                        else
                        {
                            <span class="badge @StatusClass(item.Status)" title="@(item.MatchSource is { } src ? L["yt.queue.match", ("source", SourceLabel(src)), ("confidence", Confidence(item))] : null)">@StatusLabel(item.Status)</span>
                        }
                        <span class="row-actions">
                            @if (item.Status == "Done")
                            {
                                <button class="icon-btn" title="@L["yt.queue.editMetadata"]" @onclick="() => OpenReviewAsync(item)"><Icon Name="edit" Size="18" /></button>
                                @if (item.AlbumId is { } album) { <a class="icon-btn" href="album/@album" title="@L["track.goToAlbum"]"><Icon Name="album" Size="18" /></a> }
                            }
                            @if (item.Status is "Failed" && item.Error?.Contains("format", StringComparison.OrdinalIgnoreCase) == true)
                            {
                                <button class="icon-btn" title="@L["yt.queue.formats"]" @onclick="() => OpenFormatsAsync(item)"><Icon Name="settings" Size="18" /></button>
                            }
                            @if (item.Status is "Failed" or "Skipped")
                            {
                                <button class="icon-btn" title="@L["yt.queue.retry"]" @onclick="() => RetryAsync(item)"><Icon Name="refresh" Size="18" /></button>
                            }
                            @if (item.Status is not ("Downloading" or "Processing"))
                            {
                                <button class="icon-btn" title="@(item.TrackId is null ? L["yt.queue.removeItem"] : L["yt.queue.deleteTrack"])" @onclick="() => DeleteAsync(item)"><Icon Name="delete" Size="18" /></button>
                            }
                        </span>
                    </li>
                }
            </ul>
            @if (pg.Total > pg.Items.Count)
            {
                <div class="more"><button class="btn" @onclick="MoreAsync">@L["common.showMore"] (@pg.Items.Count / @pg.Total)</button></div>
            }
        }
    };

    private async Task SetFilterAsync(int index)
    {
        _filter = index;
        _limit = 50;
        await LoadItemsAsync();
    }

    private async Task MoreAsync()
    {
        _limit += 100;
        await LoadItemsAsync();
    }

    private async Task LoadItemsAsync()
    {
        var f = Filters[_filter];
        try
        {
            _items = await Api.YoutubeItemsAsync(f.Status, f.Review, _itemQuery, 0, _limit);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
        }
    }

    private async Task RetryAsync(YoutubeItemDto item)
    {
        await Run(() => Api.YoutubeRetryAsync(item.Id));
        await LoadItemsAsync();
    }

    // Échec « format indisponible » : la liste des formats relevée par le serveur, et un format pour cette tentative.
    private YoutubeItemDto? _formatsItem;
    private string? _formats;
    private string _format = "";

    private async Task OpenFormatsAsync(YoutubeItemDto item)
    {
        _formatsItem = item;
        _format = "";
        _formats = await Run(() => Api.YoutubeFormatsAsync(item.Id));
    }

    private async Task RetryWithFormatAsync()
    {
        if (_formatsItem is not { } item) return;
        if (await Run(() => Api.YoutubeRetryAsync(item.Id, _format), L["yt.queue.retried"]))
        {
            _formatsItem = null;
            await LoadItemsAsync();
        }
    }

    private async Task RetryFailedAsync()
    {
        await Run(Api.YoutubeRetryFailedAsync, L["yt.queue.failedRequeued"]);
        await LoadItemsAsync();
    }

    private async Task DeleteAsync(YoutubeItemDto item)
    {
        await Run(() => Api.YoutubeDeleteItemAsync(item.Id, deleteTrack: true), item.TrackId is null ? null : L["yt.queue.trackDeleted"]);
        await LoadItemsAsync();
        await RefreshStatusAsync();
    }

    // ---------- Vérification ----------

    private sealed class Review(YoutubeItemDto item)
    {
        public YoutubeItemDto Item { get; } = item;
        public List<MetadataCandidateDto> Candidates { get; set; } = [];
        public MetadataCandidateDto? Selected { get; set; }
        public CandidateForm Edit { get; set; } = new();
        public string? SearchTitle { get; set; }
        public string? SearchArtist { get; set; }
        public bool Searching { get; set; }
        public bool Applying { get; set; }
    }

    private sealed class CandidateForm
    {
        public string? Title { get; set; }
        public string? Artist { get; set; }
        public string? Album { get; set; }
        public string? AlbumArtist { get; set; }
        public int? TrackNumber { get; set; }
        public int? Year { get; set; }
        public string? Genre { get; set; }
    }

    private Review? _review;

    private async Task OpenReviewAsync(YoutubeItemDto item)
    {
        var review = new Review(item) { SearchTitle = item.TrackTitle, SearchArtist = item.TrackArtist };
        review.Candidates = await Run(() => Api.YoutubeCandidatesAsync(item.Id)) ?? [];
        var current = review.Candidates.FirstOrDefault(c => c.Title == item.TrackTitle && c.Artist == item.TrackArtist) ?? review.Candidates.FirstOrDefault();
        if (current is not null) Select(review, current);
        else review.Edit = new CandidateForm { Title = item.TrackTitle, Artist = item.TrackArtist, Album = item.TrackAlbum };
        _review = review;
    }

    private static void Select(Review r, MetadataCandidateDto c)
    {
        r.Selected = c;
        r.Edit = new CandidateForm { Title = c.Title, Artist = c.Artist, Album = c.Album, AlbumArtist = c.AlbumArtist, TrackNumber = c.TrackNumber, Year = c.Year, Genre = c.Genre };
    }

    private async Task SearchMusicBrainzAsync(Review r)
    {
        if (string.IsNullOrWhiteSpace(r.SearchTitle)) return;
        r.Searching = true;
        var found = await Run(() => Api.YoutubeMusicBrainzAsync(r.SearchTitle!, r.SearchArtist, r.Item.DurationSeconds)) ?? [];
        r.Candidates = found.Concat(r.Candidates).DistinctBy(c => (c.Title, c.Artist, c.Album)).Take(15).ToList();
        if (found.Count > 0) Select(r, found[0]);
        else Ui.Notify(L["yt.review.noResults"], true);
        r.Searching = false;
    }

    private async Task ApplyAsync(Review r)
    {
        var e = r.Edit;
        var s = r.Selected;
        // Les identifiants MusicBrainz (et donc la pochette) ne suivent que si l'album choisi n'a pas été modifié à la main.
        var sameRelease = s is not null && s.Album == e.Album && s.AlbumArtist == e.AlbumArtist;
        var candidate = new MetadataCandidateDto(e.Title ?? "", e.Artist ?? "", e.Album, e.AlbumArtist, e.TrackNumber, sameRelease ? s!.DiscNumber : null, e.Year, e.Genre, 1,
            s is not null && s.Title == e.Title && s.Artist == e.Artist && sameRelease ? s.Source : "manuel",
            s?.Title == e.Title ? s?.RecordingId : null, sameRelease ? s!.ReleaseId : null, sameRelease ? s!.ReleaseGroupId : null);
        r.Applying = true;
        if (await Run(() => Api.YoutubeApplyAsync(r.Item.Id, candidate), L["yt.review.applied"]))
        {
            _review = null;
            await LoadItemsAsync();
        }
        r.Applying = false;
    }

    private async Task AcceptAsync(Review r)
    {
        if (await Run(() => Api.YoutubeAcceptAsync(r.Item.Id)))
        {
            _review = null;
            await LoadItemsAsync();
        }
    }

    // ---------- Abonnements ----------

    private List<YoutubeSubscriptionDto>? _subs;
    private string _subUrl = "";
    private bool _subAlbum;
    private bool _subExisting;
    private Guid? _syncing;

    private RenderFragment Subscriptions => __builder =>
    {
        <section class="panel">
            <h2>@L["yt.subs.new"]</h2>
            <form class="inline-form" @onsubmit="AddSubscriptionAsync" @onsubmit:preventDefault="true">
                <input class="input" placeholder="@L["yt.subs.placeholder"]" @bind="_subUrl" required />
                <label class="row small"><input type="checkbox" @bind="_subAlbum" /> @L["editor.album"]</label>
                <label class="row small"><input type="checkbox" @bind="_subExisting" /> @L["yt.subs.importExisting"]</label>
                <button class="btn primary" type="submit">@L["yt.subs.subscribe"]</button>
            </form>
            <p class="muted small">@L["yt.subs.hint"]</p>
        </section>
        @if (_subs is { Count: > 0 } subs)
        {
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>@L["yt.subs.colName"]</th><th>@L["yt.subs.colImported"]</th><th>@L["yt.subs.colLastSync"]</th><th>@L["yt.subs.colEnabled"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in subs)
                        {
                            <tr @key="s.Id">
                                <td>
                                    <a href="@s.Url" target="_blank" rel="noopener noreferrer" class="strong">@s.Title</a>
                                    @if (s.IsAlbum) { <span class="badge">@L["yt.subs.album"]</span> }
                                    @if (s.LastError is { } err) { <div class="form-error small">@L.Server(err)</div> }
                                </td>
                                <td>@s.Done / @s.Items</td>
                                <td>@(s.LastSyncedAt is { } synced ? L.DateTime(synced) : L["common.never"])</td>
                                <td><input type="checkbox" checked="@s.Enabled" @onchange="e => ToggleSubscriptionAsync(s, e.Value is true)" aria-label="@L["yt.subs.colEnabled"]" /></td>
                                <td class="row-actions">
                                    <button class="icon-btn" title="@L["yt.subs.syncNow"]" disabled="@(_syncing == s.Id)" @onclick="() => SyncAsync(s)"><Icon Name="refresh" Size="18" /></button>
                                    <button class="icon-btn" title="@L["yt.subs.unsubscribe"]" @onclick="() => UnsubscribeAsync(s)"><Icon Name="delete" Size="18" /></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (_subs is not null)
        {
            <div class="empty">@L["yt.subs.none"]</div>
        }
    };

    private async Task LoadSubscriptionsAsync() => _subs = await Run(() => Api.YoutubeSubscriptionsAsync());

    private async Task AddSubscriptionAsync()
    {
        if (await Run(() => Api.YoutubeSubscribeAsync(new CreateSubscriptionRequest(_subUrl.Trim(), _subAlbum, _subExisting)), L["yt.subs.created"]))
        {
            _subUrl = "";
            await LoadSubscriptionsAsync();
        }
    }

    private async Task ToggleSubscriptionAsync(YoutubeSubscriptionDto s, bool enabled)
    {
        await Run(() => Api.YoutubeUpdateSubscriptionAsync(s.Id, new UpdateSubscriptionRequest(enabled, null)));
        await LoadSubscriptionsAsync();
    }

    private async Task SyncAsync(YoutubeSubscriptionDto s)
    {
        _syncing = s.Id;
        await Run(() => Api.YoutubeSyncSubscriptionAsync(s.Id), L["yt.subs.synced"]);
        _syncing = null;
        await LoadSubscriptionsAsync();
    }

    private async Task UnsubscribeAsync(YoutubeSubscriptionDto s)
    {
        await Run(() => Api.YoutubeDeleteSubscriptionAsync(s.Id), L["yt.subs.deleted"]);
        await LoadSubscriptionsAsync();
    }

    // ---------- Réglages ----------

    private YoutubeSettingsDto? _settings;
    private string _cookies = "";

    private RenderFragment Settings => __builder =>
    {
        <LibraryMaintenance />
        <AudioAnalysisSettings />
        <StorageSettings />
        <DiscoverySettings />
        <RadioSettingsPanel />

        <section class="panel">
            <h2>@L["yt.tools.title"]</h2>
            <p>
                yt-dlp : <span class="strong">@(_status?.Tools.YtDlp ?? L["yt.tools.missing"])</span><span class="sep">·</span>
                Deno : <span class="strong">@(_status?.Tools.Deno ?? L["yt.tools.missing"])</span><span class="sep">·</span>
                fpcalc (AcoustID) : <span class="strong">@(_status?.Tools.Fpcalc ?? L["yt.tools.missing"])</span>
            </p>
            <p class="muted small">@L["yt.tools.hint"]</p>
            <div class="row">
                <button class="btn primary" disabled="@_updating" @onclick="() => UpdateToolsAsync(false)"><Icon Name="refresh" Size="18" /> @(_updating ? L["yt.tools.updating"] : L["yt.tools.update"])</button>
                <button class="btn" disabled="@_updating" @onclick="() => UpdateToolsAsync(true)">@L["yt.tools.updateAll"]</button>
            </div>
        </section>

        <section class="panel">
            <h2>@L["yt.cookies.title"]</h2>
            <p>@(_status?.HasCookies == true ? L["yt.cookies.saved", ("date", _status.CookiesUpdatedAt is { } cu ? L.DateTime(cu) : "")] : L["yt.cookies.none"])</p>
            <p class="muted small">@L["yt.cookies.hint"]</p>
            <textarea class="input mono" rows="4" placeholder="# Netscape HTTP Cookie File" @bind="_cookies"></textarea>
            <div class="row" style="margin-top: .6rem">
                <InputFile OnChange="LoadCookiesFileAsync" accept=".txt,text/plain" />
                <button class="btn primary" disabled="@string.IsNullOrWhiteSpace(_cookies)" @onclick="SaveCookiesAsync">@L["common.save"]</button>
                @if (_status?.HasCookies == true)
                {
                    <button class="btn danger" @onclick="DeleteCookiesAsync">@L["common.delete"]</button>
                }
            </div>
            <p class="muted small">@L["yt.cookies.adult"]</p>
            @if (_settings is { } cs)
            {
                <label class="row small">
                    <input type="checkbox" checked="@cs.RetryWithoutCookies"
                           @onchange="async e => { _settings = cs with { RetryWithoutCookies = e.Value is true }; await SaveSettingsAsync(); }" />
                    @L["yt.cookies.retryWithout"]
                </label>
            }
        </section>

        @if (_settings is { } s)
        {
            <section class="panel">
                <h2>@L["yt.settings.import"]</h2>
                <div class="form-grid">
                    <label class="field">
                        <span>@L["yt.settings.sync"]</span>
                        <select class="input" value="@s.SyncIntervalHours" @onchange="e => _settings = s with { SyncIntervalHours = int.Parse(e.Value!.ToString()!) }">
                            @foreach (var h in new[] { 0, 1, 3, 6, 12, 24, 72, 168 })
                            {
                                <option value="@h">@(h == 0 ? L["yt.settings.syncNever"] : h < 24 ? L["yt.settings.syncHours", ("count", h)] : h == 24 ? L["yt.settings.syncDaily"] : L["yt.settings.syncDays", ("count", h / 24)])</option>
                            }
                        </select>
                    </label>
                    <label class="field">
                        <span>@L["yt.settings.parallel"]</span>
                        <select class="input" value="@s.ParallelDownloads" @onchange="e => _settings = s with { ParallelDownloads = int.Parse(e.Value!.ToString()!) }">
                            @for (var n = 1; n <= 6; n++)
                            {
                                <option value="@n">@n</option>
                            }
                        </select>
                    </label>
                    <label class="field">
                        <span>@L["yt.settings.audioFormat"]</span>
                        <select class="input" value="@s.AudioFormat" @onchange="e => _settings = s with { AudioFormat = e.Value!.ToString()! }">
                            <option value="original">@L["yt.settings.original"]</option>
                            <option value="mp3">@L["yt.settings.mp3"]</option>
                        </select>
                    </label>
                    <label class="field">
                        <span>@L["yt.settings.threshold", ("value", L["format.percent", ("value", L.Number(s.AutoAcceptThreshold * 100))])]</span>
                        <input type="range" min="0.5" max="1" step="0.05" value="@s.AutoAcceptThreshold.ToString(CultureInfo.InvariantCulture)"
                               @onchange="e => _settings = s with { AutoAcceptThreshold = double.Parse(e.Value!.ToString()!, CultureInfo.InvariantCulture) }" />
                    </label>
                    <label class="field">
                        <span>@L["yt.settings.acoustid"]</span>
                        <input class="input" value="@s.AcoustIdKey" placeholder="acoustid.org/new-application" @onchange="e => _settings = s with { AcoustIdKey = e.Value?.ToString() }" />
                    </label>
                </div>
                <p class="muted small">@L["yt.settings.parallelHint"]</p>
                <p class="muted small">@L["yt.settings.acoustidHint"]</p>
                <button class="btn primary" @onclick="SaveSettingsAsync">@L["common.save"]</button>
            </section>
        }
    };

    private async Task UpdateToolsAsync(bool deno)
    {
        _updating = true;
        StateHasChanged();
        var tools = await Run(() => Api.YoutubeUpdateToolsAsync(deno));
        if (tools is not null) Ui.Notify($"yt-dlp {tools.YtDlp} · Deno {tools.Deno}");
        _updating = false;
        await RefreshStatusAsync();
    }

    private async Task LoadCookiesFileAsync(InputFileChangeEventArgs e)
    {
        using var reader = new StreamReader(e.File.OpenReadStream(2 * 1024 * 1024));
        _cookies = await reader.ReadToEndAsync();
    }

    private async Task SaveCookiesAsync()
    {
        if (await Run(() => Api.YoutubeSaveCookiesAsync(_cookies), L["yt.cookies.savedToast"]))
        {
            _cookies = "";
            await RefreshStatusAsync();
        }
    }

    private async Task DeleteCookiesAsync()
    {
        await Run(Api.YoutubeDeleteCookiesAsync, L["yt.cookies.deleted"]);
        await RefreshStatusAsync();
    }

    private async Task SaveSettingsAsync()
    {
        if (_settings is { } s && await Run(() => Api.YoutubeSaveSettingsAsync(s)) is { } saved)
        {
            _settings = saved;
            Ui.Notify(L["yt.settings.saved"]);
        }
    }

    // ---------- Libellés ----------

    private string StatusLabel(string status) => Label("yt.status." + status, status);

    private string Label(string key, string fallback) => L.Has(key) ? L[key] : fallback;

    private static string StatusClass(string status) => status switch
    {
        "Done" => "good",
        "Failed" => "bad",
        "Downloading" or "Downloaded" or "Processing" or "Queued" => "info",
        _ => "",
    };

    private string StageLabel(string stage) => Label("yt.stage." + stage, stage);

    private string SourceLabel(string source) => Label("yt.source." + source, source);

    private string Confidence(YoutubeItemDto item) => item.MatchConfidence is { } c ? L["format.percent", ("value", L.Number(c * 100))] : "";
}
