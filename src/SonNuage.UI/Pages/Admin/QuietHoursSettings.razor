@inject ApiClient Api
@inject UiState Ui
@inject IJSRuntime JS

@* Réglages → Heures calmes : plage quotidienne pendant laquelle les files choisies (analyse audio…) sont retenues. *@
<section class="panel" id="quiet-hours">
    <h2>@L["quietHours.title"]</h2>
    @if (_q is { } q)
    {
        <label class="row small" style="margin: 0 0 .6rem; flex-wrap: nowrap; align-items: flex-start">
            <input type="checkbox" @bind="_enabled" />
            <span>@L["quietHours.enabled"]</span>
        </label>
        <div class="form-grid">
            <label class="field">
                <span>@L["quietHours.from"]</span>
                <input class="input" type="time" @bind="_start" />
            </label>
            <label class="field">
                <span>@L["quietHours.to"]</span>
                <input class="input" type="time" @bind="_end" />
            </label>
        </div>
        <p class="small" style="margin: .8rem 0 .3rem">@L["quietHours.lanes"]</p>
        <div class="row small" style="gap: .4rem 1.2rem">
            @foreach (var lane in Lanes)
            {
                <label class="row" style="gap: .35rem">
                    <input type="checkbox" checked="@_lanes.Contains(lane)" @onchange="e => Toggle(lane, e.Value is true)" />
                    <span>@L["jobs.lane." + lane]</span>
                </label>
            }
        </div>
        <p class="muted small">@L["quietHours.zone", ("zone", _zone)] @L["quietHours.hint"]</p>
        <button class="btn primary" disabled="@_saving" @onclick="SaveAsync">@L["common.save"]</button>
    }
    else
    {
        <Logo Size="16" Animated="true" />
    }
</section>

@code {
    // Même ordre que le volet Tâches.
    private static readonly string[] Lanes = ["download", "acoustid", "metadata", "library", "sync", "discovery", "analysis"];
    private QuietHoursDto? _q;
    private bool _enabled, _saving;
    private TimeOnly _start, _end;
    private HashSet<string> _lanes = [];
    private string _zone = "UTC";

    protected override async Task OnInitializedAsync()
    {
        await RunAsync(async () => Show(await Api.QuietHoursAsync()));
        try
        {
            _zone = await JS.InvokeAsync<string>("sonnuage.timeZone");
        }
        catch (JSException)
        {
            // Fuseau introuvable : celui déjà enregistré reste.
            _zone = _q?.TimeZone ?? _zone;
        }
    }

    private void Show(QuietHoursDto? q)
    {
        if (q is null) return;
        _q = q;
        (_enabled, _start, _end, _lanes) = (q.Enabled, q.Start, q.End, q.Lanes.ToHashSet());
    }

    private void Toggle(string lane, bool on)
    {
        if (on) _lanes.Add(lane);
        else _lanes.Remove(lane);
    }

    private async Task SaveAsync()
    {
        _saving = true;
        await RunAsync(async () =>
        {
            Show(await Api.SaveQuietHoursAsync(new QuietHoursDto(_enabled, _start, _end, Lanes.Where(_lanes.Contains).ToList(), _zone)));
            Ui.Notify(L["quietHours.saved"]);
        });
        _saving = false;
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }
}
