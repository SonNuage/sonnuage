@page "/admin/upload"
@inject ApiClient Api
@inject UiState Ui

<PageTitle>@L["admin.tabs.upload"] · SonNuage</PageTitle>

<div class="page">
    <AdminNav Title="@L["admin.nav.upload"]">
        <section class="panel">
            <h2>@L["admin.tabs.upload"]</h2>
            <p class="muted">
                @L["upload.intro"]
                @L["upload.resumable"]
            </p>
            <div class="form-grid">
                <label class="field"><span>@L["upload.artistHint"]</span><input class="input" @bind="_artist" /></label>
                <label class="field"><span>@L["upload.albumHint"]</span><input class="input" @bind="_album" /></label>
            </div>
            <label class="dropzone @(_busy ? "disabled" : "")">
                <Icon Name="upload" Size="40" />
                <span>@L["upload.drop"]</span>
                <small>MP3, FLAC, WAV, OGG, Opus, M4A, AAC, WMA, AIFF…</small>
                <InputFile OnChange="OnFilesSelected" multiple accept="audio/*,.flac,.wav,.mp3,.ogg,.opus,.m4a,.aac,.wma,.aiff,.aif,.ape,.wv" disabled="@_busy" />
            </label>
        </section>

        @if (_items.Count > 0)
        {
            <section class="panel">
                <h2>@L["upload.list"]</h2>
                <ul class="upload-list">
                    @foreach (var item in _items)
                    {
                        <li class="upload-item @item.Status.ToString().ToLowerInvariant()">
                            <div class="upload-name">
                                <span>@item.Name</span>
                                <small>@Format.Bytes(item.Size) - @StatusLabel(item)</small>
                            </div>
                            <progress max="100" value="@item.Percent"></progress>
                            @if (item.Result is { } t)
                            {
                                <a href="album/@t.AlbumId" class="link">@t.ArtistName - @t.AlbumTitle</a>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    </AdminNav>
</div>

@code {
    private const long MaxFileSize = 4L * 1024 * 1024 * 1024;
    private const int MaxRetries = 5;

    private readonly List<UploadItem> _items = [];
    private string? _artist;
    private string? _album;
    private bool _busy;

    private enum UploadStatus { Pending, Uploading, Processing, Done, Error }

    private sealed class UploadItem(IBrowserFile file)
    {
        public IBrowserFile File { get; } = file;
        public string Name => File.Name;
        public long Size => File.Size;
        public UploadStatus Status { get; set; }
        public long Sent { get; set; }
        public string? Error { get; set; }
        public TrackDto? Result { get; set; }
        public int Percent => Size == 0 ? 0 : (int)(Sent * 100 / Size);
    }

    private string StatusLabel(UploadItem i) => i.Status switch
    {
        UploadStatus.Pending => L["upload.status.pending"],
        UploadStatus.Uploading => $"{i.Percent} %",
        UploadStatus.Processing => L["upload.status.processing"],
        UploadStatus.Done => L["upload.status.done"],
        _ => i.Error ?? L["upload.status.failed"],
    };

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        var batch = e.GetMultipleFiles(500).Select(f => new UploadItem(f)).ToList();
        _items.InsertRange(0, batch);
        _busy = true;
        foreach (var item in batch)
        {
            await UploadAsync(item);
            StateHasChanged();
        }
        _busy = false;
        var ok = batch.Count(i => i.Status == UploadStatus.Done);
        Ui.Notify(L["upload.summary", ("ok", ok), ("total", batch.Count)], ok < batch.Count);
    }

    private async Task UploadAsync(UploadItem item)
    {
        if (item.Size > MaxFileSize)
        {
            Fail(item, L["upload.tooLarge"]);
            return;
        }

        UploadSessionDto? session;
        try
        {
            session = await Api.AdminStartUploadAsync(new StartUploadRequest(item.Name, item.Size, Blank(_artist), Blank(_album)));
        }
        catch (ApiException ex)
        {
            Fail(item, L.Server(ex.Message));
            return;
        }
        if (session is null)
        {
            Fail(item, L["upload.sessionRefused"]);
            return;
        }

        item.Status = UploadStatus.Uploading;
        StateHasChanged();
        var buffer = new byte[session.ChunkSize];
        try
        {
            await using var stream = item.File.OpenReadStream(MaxFileSize);
            var offset = 0L;
            while (offset < item.Size)
            {
                var read = await ReadChunkAsync(stream, buffer);
                if (read == 0) break;
                offset = await SendChunkWithRetryAsync(session.Id, offset, buffer.AsMemory(0, read));
                item.Sent = offset;
                StateHasChanged();
            }

            item.Status = UploadStatus.Processing;
            StateHasChanged();
            var tracks = await Api.AdminCompleteUploadAsync(session.Id);
            item.Result = tracks?.FirstOrDefault();
            item.Status = UploadStatus.Done;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or IOException)
        {
            Fail(item, L.Server(ex.Message));
            try { await Api.AdminCancelUploadAsync(session.Id); } catch (Exception) { }
        }
    }

    /// <summary>Envoie un morceau. Sur erreur réseau, relit l'offset côté serveur et renvoie ce qui manque.</summary>
    private async Task<long> SendChunkWithRetryAsync(Guid id, long offset, ReadOnlyMemory<byte> chunk)
    {
        for (var attempt = 0; ; attempt++)
        {
            try
            {
                var s = await Api.AdminUploadChunkAsync(id, offset, chunk);
                if (s is null) throw new ApiException(System.Net.HttpStatusCode.NotFound, L["upload.sessionExpired"]);
                if (s.Received == offset + chunk.Length) return s.Received;
                // Le serveur a un autre offset : il a déjà tout ou partie de ce morceau.
                if (s.Received > offset && s.Received <= offset + chunk.Length)
                {
                    var done = (int)(s.Received - offset);
                    if (done == chunk.Length) return s.Received;
                    chunk = chunk[done..];
                    offset = s.Received;
                    continue;
                }
                throw new ApiException(System.Net.HttpStatusCode.Conflict, L["upload.desync"]);
            }
            catch (HttpRequestException) when (attempt < MaxRetries)
            {
                await Task.Delay(TimeSpan.FromSeconds(Math.Pow(2, attempt)));
                var status = await Api.AdminUploadStatusAsync(id);
                if (status is not null && status.Received > offset)
                {
                    var done = (int)Math.Min(status.Received - offset, chunk.Length);
                    chunk = chunk[done..];
                    offset += done;
                    if (chunk.IsEmpty) return offset;
                }
            }
        }
    }

    private static async Task<int> ReadChunkAsync(Stream stream, byte[] buffer)
    {
        var total = 0;
        while (total < buffer.Length)
        {
            var n = await stream.ReadAsync(buffer.AsMemory(total));
            if (n == 0) break;
            total += n;
        }
        return total;
    }

    private void Fail(UploadItem item, string message)
    {
        item.Status = UploadStatus.Error;
        item.Error = message;
    }

    private static string? Blank(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}
