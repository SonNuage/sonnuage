@page "/admin/tasks"
@* Gestionnaire de tâches : files, suites (import YouTube, rescan AcoustID…), étapes et journal en direct. *@
@implements IDisposable
@inject ApiClient Api
@inject UiState Ui
@using System.Globalization

<PageTitle>@L["admin.tabs.tasks"] · SonNuage</PageTitle>

<div class="page">
    <AdminNav Title="@L["admin.nav.tasks"]">
        <Actions>
            <button class="btn primary" @onclick="OpenNewTaskAsync"><Icon Name="add" Size="18" /> @L["jobs.create.button"]</button>
        </Actions>
        <ChildContent>
        @if (_overview is { } ov)
        {
            <div class="lanes">
                @foreach (var lane in ov.Lanes)
                {
                    <div class="lane @(lane.Running > 0 ? "busy" : null)">
                        <span class="strong">@Label("jobs.lane." + lane.Lane, lane.Lane)</span>
                        <span class="muted small">@L["jobs.laneLoad", ("running", lane.Running), ("capacity", lane.Capacity), ("queued", L.Number(lane.Queued))]</span>
                    </div>
                }
            </div>
        }

        <div class="toolbar">
            <div class="tabs sub" style="margin: 0">
                @foreach (var f in Filters)
                {
                    <button class="tab @(_filter == f ? "active" : null)" @onclick="() => FilterAsync(f)">@L["jobs.filter." + f]</button>
                }
            </div>
            <input class="input" placeholder="@L["jobs.search"]" @bind="_q" @bind:event="oninput" @bind:after="() => FilterAsync(_filter)" />
        </div>

        <div class="jobs-layout">
            <section>
                @if (_overview is null)
                {
                    <Loader />
                }
                else if (_overview.Suites.Items.Count == 0)
                {
                    <div class="empty">@L["jobs.none"]</div>
                }
                else
                {
                    <ul class="yt-list">
                        @foreach (var s in _overview.Suites.Items)
                        {
                            <li @key="s.Id" class="clickable @(s.Id == _suiteId ? "selected" : null)" @onclick="() => OpenSuiteAsync(s.Id)">
                                <span class="grow">
                                    <span class="strong">@L.Server(s.Title)</span>
                                    <span class="muted small block">@Label("jobs.suiteKind." + Key(s.Kind), s.Kind) · @L.DateTime(s.CreatedAt) · @L["jobs.progress", ("done", L.Number(s.Succeeded + s.Failed + s.Canceled)), ("total", L.Number(s.Total))]</span>
                                    @if (s.Total > 1 && s.Waiting + s.Running > 0)
                                    {
                                        <progress max="@s.Total" value="@(s.Succeeded + s.Failed + s.Canceled)"></progress>
                                    }
                                </span>
                                @if (s.Failed > 0 && s.Status != "Failed") { <span class="badge bad">@L["jobs.failedCount", ("count", L.Number(s.Failed))]</span> }
                                <span class="badge @StatusClass(s.Status)">@StatusLabel(s.Status)</span>
                            </li>
                        }
                    </ul>
                    @if (_overview.Suites.Total > _overview.Suites.Items.Count)
                    {
                        <button class="btn wide" style="margin-top: .6rem" @onclick="MoreSuitesAsync">@L["jobs.more", ("count", L.Number(_overview.Suites.Total - _overview.Suites.Items.Count))]</button>
                    }
                }
            </section>

            <section>
                @if (_suiteId is not null && _jobs is { } jobs)
                {
                    <div class="panel">
                        <div class="row">
                            <h2 class="grow" style="margin: 0">@L["jobs.stepsTitle"]</h2>
                            @if (jobs.Items.Any(j => j.Status is "Pending" or "Queued" or "Running"))
                            {
                                <button class="btn danger" @onclick="CancelSuiteAsync">@L["jobs.cancelSuite"]</button>
                            }
                            else
                            {
                                <button class="btn" @onclick="DeleteSuiteAsync">@L["jobs.deleteSuite"]</button>
                            }
                        </div>
                        <ul class="yt-list">
                            @foreach (var j in jobs.Items)
                            {
                                <li @key="j.Id" class="clickable @(j.Id == _jobId ? "selected" : null)" @onclick="() => OpenJobAsync(j.Id)">
                                    <span class="grow">
                                        <span class="strong">@L.Server(j.Title)</span>
                                        <span class="muted small block">@Label("jobs.kind." + Key(j.Kind), j.Kind)@(j.Attempts > 1 ? " · " + L["jobs.attempts", ("n", j.Attempts), ("max", j.MaxAttempts)] : "")@(Duration(j) is { } d ? " · " + d : "")</span>
                                        @if (j.Status == "Running" && j.Progress is { } p) { <progress max="1" value="@p.ToString(System.Globalization.CultureInfo.InvariantCulture)"></progress> }
                                        @if (j.Error is { } err && j.Status != "Succeeded") { <span class="form-error small block">@L.Server(err)</span> }
                                    </span>
                                    <span class="badge @StatusClass(j.Status)">@StatusLabel(j.Status, j)</span>
                                </li>
                            }
                        </ul>
                        @if (jobs.Total > jobs.Items.Count)
                        {
                            <button class="btn wide" style="margin-top: .6rem" @onclick="MoreJobsAsync">@L["jobs.more", ("count", L.Number(jobs.Total - jobs.Items.Count))]</button>
                        }
                    </div>

                    @if (_job is { } detail)
                    {
                        var job = detail.Job;
                        <div class="panel">
                            <div class="row">
                                <h2 class="grow" style="margin: 0">@L.Server(job.Title)</h2>
                                @if (job.Status is "Pending" or "Queued" or "Running") { <button class="btn danger" @onclick="() => CancelJobAsync(job.Id)">@L["common.cancel"]</button> }
                                @if (job.Status is "Failed" or "Canceled") { <button class="btn" @onclick="() => RetryJobAsync(job.Id)">@L["jobs.retry"]</button> }
                            </div>
                            <p class="muted small">
                                @Label("jobs.kind." + Key(job.Kind), job.Kind) · @L["jobs.inLane", ("lane", Label("jobs.lane." + job.Lane, job.Lane))]
                                @if (job.StartedAt is { } started) { <span> · @L["jobs.startedAt", ("date", L.DateTime(started))]</span> }
                                @if (job.Status == "Queued" && job.NotBefore > DateTimeOffset.UtcNow) { <span> · @L["jobs.notBefore", ("date", L.DateTime(job.NotBefore))]</span> }
                            </p>
                            @* Ordre inversé en CSS : la vue reste collée aux dernières lignes. *@
                            <div class="job-log mono">
                                <div>
                                    @if (_logs.Count == 0)
                                    {
                                        <span class="muted">@L["jobs.noLogs"]</span>
                                    }
                                    @foreach (var line in _logs)
                                    {
                                        <div class="@line.Level" @key="line.Id"><span class="muted">@line.At.ToLocalTime().ToString("HH:mm:ss")</span> @L.Server(line.Message)</div>
                                    }
                                </div>
                            </div>
                            @if (detail.Payload is not null || detail.Output is not null)
                            {
                                <details style="margin-top: .6rem">
                                    <summary class="small muted">@L["jobs.data"]</summary>
                                    @if (detail.Payload is { } payload) { <pre class="mono">@payload</pre> }
                                    @if (detail.Output is { } output) { <pre class="mono">@output</pre> }
                                </details>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="empty small">@L["jobs.pick"]</div>
                }
            </section>
        </div>
        </ChildContent>
    </AdminNav>
</div>


<Modal @bind-Open="_newTask" Title="@L["jobs.create.title"]">
    <ChildContent>
        <p class="muted small">@L["jobs.create.intro"]</p>
        <div class="row">
            <label class="row small"><input type="radio" name="scope" checked="@(!_byArtist)" @onchange="() => _byArtist = false" /> @L["jobs.create.all"]</label>
            <label class="row small"><input type="radio" name="scope" checked="@_byArtist" @onchange="() => _byArtist = true" /> @L["jobs.create.artist"]</label>
        </div>
        @if (_byArtist)
        {
            <div class="field" style="margin-top: .6rem">
                @if (_artist is { } picked)
                {
                    <div class="row">
                        <span class="badge info">@picked.Name</span>
                        <button class="btn" @onclick="() => _artist = null">@L["jobs.create.otherArtist"]</button>
                    </div>
                }
                else
                {
                    <input class="input" placeholder="@L["jobs.create.artistPlaceholder"]" @bind="_artistQuery" @bind:event="oninput" @bind:after="SearchArtistsAsync" autocomplete="off" />
                    @if (_artists is { Count: > 0 })
                    {
                        <div class="list">
                            @foreach (var a in _artists)
                            {
                                <button class="list-item" @key="a.Id" @onclick="() => { _artist = a; _artists = null; }">
                                    <div><span class="list-title">@a.Name</span><span class="list-sub">@L["library.tracks", ("count", a.TrackCount)]</span></div>
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        }
        <label class="row small" style="margin: .6rem 0; flex-wrap: nowrap; align-items: flex-start">
            <input type="checkbox" @bind="_apply" />
            <span>@L["jobs.create.apply"]</span>
        </label>
        @if (_apply)
        {
            <label class="field">
                <span>@L["yt.settings.threshold", ("value", L["format.percent", ("value", L.Number(Math.Round(_threshold * 100)))])]</span>
                <input class="slider" type="range" min="0.5" max="1" step="0.01" value="@_threshold.ToString(CultureInfo.InvariantCulture)"
                       style="--pct: @(((_threshold - 0.5) * 200).ToString("0", CultureInfo.InvariantCulture))%"
                       @oninput="e => _threshold = double.Parse(e.Value!.ToString()!, CultureInfo.InvariantCulture)" />
                <small class="muted">@L["jobs.create.thresholdHint"]</small>
            </label>
        }
    </ChildContent>
    <Footer>
        <button class="btn" @onclick="() => _newTask = false">@L["common.cancel"]</button>
        <button class="btn primary" disabled="@(_creating || (_byArtist && _artist is null))" @onclick="CreateAsync">@L["jobs.create.start"]</button>
    </Footer>
</Modal>
@code {
    private static readonly string[] Filters = ["active", "failed", "finished", "all"];
    private const int SuitePage = 30;
    private const int JobPage = 100;

    private JobsOverviewDto? _overview;
    private string _filter = "active";
    private string _q = "";
    private int _suiteLimit = SuitePage;
    private Guid? _suiteId;
    private PagedResult<JobDto>? _jobs;
    private int _jobLimit = JobPage;
    private Guid? _jobId;
    private JobDetailDto? _job;
    private readonly List<JobLogDto> _logs = [];

    private bool _byArtist;
    private string _artistQuery = "";
    private List<ArtistDto>? _artists;
    private ArtistDto? _artist;
    private bool _apply = true;
    private double _threshold = 0.9;
    private bool _creating;

    private Timer? _timer;
    private int _tick;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // Journal de la tâche ouverte : chaque seconde. Listes : toutes les trois secondes.
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            if (_busy) return;
            _busy = true;
            try
            {
                if (_jobId is not null) await LoadJobAsync(appendOnly: true);
                if (++_tick % 3 == 0) await LoadAsync();
                StateHasChanged();
            }
            finally
            {
                _busy = false;
            }
        }), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public void Dispose() => _timer?.Dispose();

    private async Task LoadAsync()
    {
        await TryAsync(async () =>
        {
            _overview = await Api.JobsAsync(_filter == "all" ? null : _filter, _q, 0, _suiteLimit);
            if (_suiteId is { } id) _jobs = await Api.JobSuiteAsync(id, 0, _jobLimit);
        });
    }

    private async Task FilterAsync(string filter)
    {
        _filter = filter;
        _suiteLimit = SuitePage;
        await LoadAsync();
    }

    private async Task MoreSuitesAsync()
    {
        _suiteLimit += SuitePage;
        await LoadAsync();
    }

    private async Task MoreJobsAsync()
    {
        _jobLimit += JobPage;
        await LoadAsync();
    }

    private async Task OpenSuiteAsync(Guid id)
    {
        _suiteId = id;
        _jobLimit = JobPage;
        _jobs = null;
        _jobId = null;
        _job = null;
        await TryAsync(async () =>
        {
            _jobs = await Api.JobSuiteAsync(id, 0, _jobLimit);
            // La tâche en cours (ou la première) s'ouvre d'office.
            if ((_jobs?.Items.FirstOrDefault(j => j.Status == "Running") ?? _jobs?.Items.FirstOrDefault()) is { } first) await OpenJobAsync(first.Id);
        });
    }

    private async Task OpenJobAsync(Guid id)
    {
        _jobId = id;
        _job = null;
        _logs.Clear();
        await LoadJobAsync(appendOnly: false);
    }

    private async Task LoadJobAsync(bool appendOnly)
    {
        if (_jobId is not { } id) return;
        await TryAsync(async () =>
        {
            var after = _logs.Count == 0 ? 0 : _logs[^1].Id;
            var lines = await Api.JobLogsAsync(id, after) ?? [];
            if (_jobId != id) return;
            _logs.AddRange(lines);
            // Les lignes déjà reçues ne changent pas : seul l'état de la tâche est relu.
            if (!appendOnly || lines.Count > 0 || _job?.Job.Status is "Pending" or "Queued" or "Running") _job = await Api.JobAsync(id);
        });
    }

    private async Task SearchArtistsAsync()
    {
        var q = _artistQuery.Trim();
        if (q.Length < 2)
        {
            _artists = null;
            return;
        }
        await TryAsync(async () =>
        {
            var page = await Api.ArtistsAsync(0, 8, q);
            if (_artistQuery.Trim() == q) _artists = page?.Items.ToList();
        });
    }

    private bool _newTask;

    // Le curseur part du seuil des réglages YouTube, réglable pour cette tâche seulement.
    private async Task OpenNewTaskAsync()
    {
        _newTask = true;
        try
        {
            if (await Api.YoutubeSettingsAsync() is { } s) _threshold = s.AutoAcceptThreshold;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
        }
    }

    private async Task CreateAsync()
    {
        _creating = true;
        await TryAsync(async () =>
        {
            var suite = await Api.CreateJobAsync(new CreateJobRequest("acoustid-rescan", _byArtist ? _artist?.Id : null, _apply, _apply ? _threshold : null));
            Ui.Notify(L["jobs.create.started"]);
            _newTask = false;
            _filter = "active";
            await LoadAsync();
            await OpenSuiteAsync(suite);
        });
        _creating = false;
    }

    private async Task CancelSuiteAsync()
    {
        if (_suiteId is not { } id) return;
        await TryAsync(async () =>
        {
            await Api.CancelJobSuiteAsync(id);
            await LoadAsync();
        });
    }

    private async Task DeleteSuiteAsync()
    {
        if (_suiteId is not { } id) return;
        await TryAsync(async () =>
        {
            await Api.DeleteJobSuiteAsync(id);
            _suiteId = null;
            _jobs = null;
            _jobId = null;
            _job = null;
            await LoadAsync();
        });
    }

    private async Task CancelJobAsync(Guid id) => await TryAsync(async () =>
    {
        await Api.CancelJobAsync(id);
        await LoadAsync();
        await LoadJobAsync(appendOnly: false);
    });

    private async Task RetryJobAsync(Guid id) => await TryAsync(async () =>
    {
        await Api.RetryJobAsync(id);
        await LoadAsync();
        await LoadJobAsync(appendOnly: false);
    });

    private async Task TryAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }

    private static string Key(string kind) => kind.Replace('.', '_').Replace('-', '_');

    private string Label(string key, string fallback) => L.Has(key) ? L[key] : fallback;

    private string StatusLabel(string status, JobDto? job = null) =>
        status == "Running" && job?.Progress is { } p && p > 0 ? L["format.percent", ("value", L.Number(p * 100))] : L["jobs.status." + status];

    private static string StatusClass(string status) => status switch
    {
        "Succeeded" => "good",
        "Failed" => "bad",
        "Running" => "info",
        "Canceled" => "warn",
        _ => "",
    };

    private string? Duration(JobDto j) =>
        j is { StartedAt: { } s, FinishedAt: { } f } && f >= s ? L["jobs.duration", ("seconds", L.Number((f - s).TotalSeconds, 1))] : null;
}
