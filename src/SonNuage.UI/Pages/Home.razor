@page "/"
@inject ApiClient Api
@inject IPlayer Player
@inject UiState Ui
@inject AuthSession Auth

<PageTitle>SonNuage</PageTitle>

<div class="page">
    <header class="page-header">
        <h1>@Greeting</h1>
        <button class="btn primary" @onclick="ShuffleAllAsync"><Icon Name="shuffle" Size="18" /> @L["home.shuffleAll"]</button>
    </header>

    <Loader Loading="_home is null && _error is null" Error="@_error" OnRetry="LoadAsync">
        @if (_home is { } home)
        {
            @if (home.Playlists.Count > 0)
            {
                <section>
                    <h2>@L["home.yourPlaylists"]</h2>
                    <div class="chips">
                        <a class="chip" href="favorites"><span class="chip-icon liked"><Icon Name="heart" Size="20" /></span>@L["nav.likedSongs"]</a>
                        @foreach (var p in home.Playlists.Take(7))
                        {
                            <a class="chip" href="playlist/@p.Id">
                                <Cover AlbumId="p.CoverAlbumId" HasCover="p.CoverAlbumId is not null" Size="96" Class="cover-xs" Seed="@p.Name" />
                                @p.Name
                            </a>
                        }
                    </div>
                </section>
            }

            <RadioRow />

            @if (home.RecentlyPlayed.Count > 0)
            {
                <section>
                    <h2>@L["home.recentlyPlayed"]</h2>
                    <TrackList Tracks="home.RecentlyPlayed.Take(10).ToList()" ShowCover="true" />
                </section>
            }

            @if (home.Rediscover is { Count: > 0 } rediscover)
            {
                <section>
                    <h2>@L["home.rediscover"]</h2>
                    <p class="muted section-hint">@L["home.rediscoverHint"]</p>
                    <TrackList Tracks="rediscover.Take(10).ToList()" ShowCover="true" />
                </section>
            }

            @* Recommandations ListenBrainz (compte relié) : arrivent après le reste de l'accueil, sans le retarder. *@
            @if (_recommended is { } reco && (reco.Tracks.Count > 0 || reco.Outside.Count > 0))
            {
                <section>
                    <h2>@L["home.recommended"]</h2>
                    <p class="muted section-hint">@L["home.recommendedHint"]</p>
                    @if (reco.Tracks.Count > 0)
                    {
                        <TrackList Tracks="reco.Tracks.Take(10).ToList()" ShowCover="true" />
                    }
                    @if (reco.Outside.Count > 0 && Auth.CanRequest)
                    {
                        <h3>@L["home.recommendedOutside"]</h3>
                        <ul class="history-list">
                            @foreach (var r in reco.Outside)
                            {
                                <li class="history-entry" @key="r.RecordingMbid">
                                    <span class="history-main">
                                        <span class="history-title">@r.Title</span>
                                        <span class="muted small">@r.Artist@(r.Release is { } release ? " · " + release : "")</span>
                                    </span>
                                    <a class="btn compact" href="@RequestLink(r)"><Icon Name="add" Size="16" /> @L["requests.ask"]</a>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            <section>
                <div class="section-head">
                    <h2>@L["home.recentlyAdded"]</h2>
                    <a href="library/albums" class="link">@L["common.showAll"]</a>
                </div>
                @if (home.RecentlyAdded.Count == 0)
                {
                    <p class="muted">@L["home.emptyLibrary"] @(Auth.IsAdmin ? L["home.emptyLibraryAdmin"] : "")</p>
                }
                <AlbumGrid Albums="home.RecentlyAdded" />
            </section>

            @if (home.NewReleases is { Count: > 0 } newReleases)
            {
                <section>
                    <div class="section-head">
                        <h2>@L["home.newReleases"]</h2>
                        <a href="discover" class="link">@L["common.showAll"]</a>
                    </div>
                    <p class="muted section-hint">@(Auth.CanRequest ? L["home.newReleasesHint"] : L["home.newReleasesHintUser"])</p>
                    <ReleaseRow Releases="newReleases" />
                </section>
            }

            @if (home.NotYetPlayed is { Count: > 0 } notYetPlayed)
            {
                <section>
                    <h2>@L["home.notYetPlayed"]</h2>
                    <p class="muted section-hint">@L["home.notYetPlayedHint"]</p>
                    <AlbumGrid Albums="notYetPlayed" />
                </section>
            }
        }
    </Loader>
</div>

@code {
    private HomeDto? _home;
    private ListenBrainzRecommendationsDto? _recommended;
    private string? _error;

    private string Greeting => DateTime.Now.Hour switch
    {
        < 5 => L["home.greeting.night"],
        < 18 => L["home.greeting.day"],
        _ => L["home.greeting.evening"],
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _home = await Api.HomeAsync();
            _ = LoadRecommendationsAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = L.Server(ex.Message);
        }
    }

    private async Task LoadRecommendationsAsync()
    {
        try
        {
            _recommended = await Api.ListenBrainzRecommendationsAsync();
            StateHasChanged();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // Accessoire : l'accueil reste complet sans.
        }
    }

    // Même circuit que la découverte : recherche par correspondance, puis demande habituelle (quota, approbation).
    private static string RequestLink(ExternalRecordingDto r) =>
        $"requests?artist={Uri.EscapeDataString(r.Artist)}&title={Uri.EscapeDataString(r.Title)}";

    private async Task ShuffleAllAsync()
    {
        try
        {
            var tracks = await Api.RandomTracksAsync(200);
            if (tracks is { Count: > 0 }) await Player.PlayAsync(tracks, 0, shuffle: false);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }
}
