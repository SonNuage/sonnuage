@page "/favorites"
@inject ApiClient Api
@inject IPlayer Player

<PageTitle>@L["nav.likedSongs"] · SonNuage</PageTitle>

<div class="page">
    <header class="hero">
        <div class="hero-cover liked-cover"><Icon Name="heart" Size="72" /></div>
        <div class="hero-meta">
            <span class="eyebrow">@L["common.playlist"]</span>
            <h1>@L["nav.likedSongs"]</h1>
            <p>@L["common.tracks", ("count", _tracks.Count)]</p>
        </div>
    </header>

    <div class="actions">
        <button class="play-btn large" title="@L["common.play"]" disabled="@(_tracks.Count == 0)" @onclick="() => Player.PlayAsync(_tracks, 0, shuffle: false)"><Icon Name="play" Size="32" /></button>
        <button class="icon-btn" title="@L["player.shuffle"]" disabled="@(_tracks.Count == 0)" @onclick="() => Player.PlayAsync(_tracks, -1, shuffle: true)"><Icon Name="shuffle" Size="28" /></button>
    </div>

    <Loader Loading="_loading" Error="@_error" OnRetry="LoadAsync">
        @if (_tracks.Count == 0 && _albums.Count == 0 && _artists.Count == 0)
        {
            <p class="empty">@L["favorites.empty"]</p>
        }
        <TrackList Tracks="_tracks" ShowCover="true" />

        @if (_albums.Count > 0)
        {
            <section>
                <h2>@L["favorites.albums"]</h2>
                <AlbumGrid Albums="_albums" />
            </section>
        }

        @if (_artists.Count > 0)
        {
            <section>
                <h2>@L["favorites.artists"]</h2>
                <div class="grid">
                    @foreach (var a in _artists)
                    {
                        <a class="card" href="artist/@a.Id" @key="a.Id">
                            <div class="card-cover round"><Cover AlbumId="a.CoverAlbumId" HasCover="a.CoverAlbumId is not null" Round="true" Seed="@a.Name" /></div>
                            <span class="card-title">@a.Name</span>
                            <span class="card-sub">@L["common.albums", ("count", a.AlbumCount)]</span>
                        </a>
                    }
                </div>
            </section>
        }
    </Loader>
</div>

@code {
    private List<TrackDto> _tracks = [];
    private List<AlbumDto> _albums = [];
    private List<ArtistDto> _artists = [];
    private bool _loading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var tracks = Api.FavoritesAsync();
            var albums = Api.FavoriteAlbumsAsync();
            var artists = Api.FavoriteArtistsAsync();
            _tracks = await tracks ?? [];
            _albums = await albums ?? [];
            _artists = await artists ?? [];
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = L.Server(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
