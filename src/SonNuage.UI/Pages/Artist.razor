@page "/artist/{Id:guid}"
@inject ApiClient Api
@inject IPlayer Player
@inject UiState Ui
@inject AuthSession Auth

<PageTitle>@(_artist?.Artist.Name ?? L["common.artist"]) · SonNuage</PageTitle>

<Loader Loading="_artist is null && _error is null" Error="@_error" OnRetry="LoadAsync">
    @if (_artist is { } a)
    {
        <div class="page">
            <header class="hero">
                <Cover AlbumId="a.Artist.CoverAlbumId" HasCover="a.Artist.CoverAlbumId is not null" Size="600" Class="hero-cover round" Round="true" Seed="@a.Artist.Name" />
                <div class="hero-meta">
                    <span class="eyebrow">@L["common.artist"]</span>
                    <h1>@a.Artist.Name</h1>
                    <p>@L["common.albums", ("count", a.Artist.AlbumCount)] · @L["common.tracks", ("count", a.Artist.TrackCount)]</p>
                </div>
            </header>

            <div class="actions">
                <button class="play-btn large" title="@L["artist.playAll"]" @onclick="() => PlayAllAsync(false)"><Icon Name="play" Size="32" /></button>
                <button class="icon-btn" title="@L["player.shuffle"]" @onclick="() => PlayAllAsync(true)"><Icon Name="shuffle" Size="28" /></button>
                <button class="icon-btn fav @(_favorite ? "on" : "")" title="@L["common.favorite"]" aria-pressed="@(_favorite ? "true" : "false")" @onclick="ToggleFavoriteAsync">
                    <Icon Name="@(_favorite ? "heart" : "heart-outline")" Size="28" />
                </button>
                <RatingStars Value="_rating" OnChange="RateAsync" />
            </div>

            @if (_tracks is { Count: > 0 } tracks)
            {
                <section>
                    <h2>@(_all ? L["artist.allTracks"] : L["artist.topTracks"])</h2>
                    <TrackList Tracks="tracks" ShowCover="true" />
                    @if (_all || a.Artist.TrackCount > TopCount)
                    {
                        <button class="btn" style="margin-top: .6rem" @onclick="ToggleAllAsync">@(_all ? L["artist.showLess"] : L["artist.showAll", ("count", a.Artist.TrackCount)])</button>
                    }
                </section>
            }

            @if (a.Albums.Count > 0)
            {
                <section>
                    <h2>@L["artist.discography"]</h2>
                    <AlbumGrid Albums="a.Albums" ShowArtist="false" />
                </section>
            }

            @if (_missing is { Count: > 0 } missing)
            {
                <section>
                    <h2>@L["artist.missingReleases"]</h2>
                    <p class="muted section-hint">@L["artist.missingReleasesHint"]</p>
                    <ReleaseRow Releases="missing" ShowArtist="false" />
                </section>
            }

            @if (_appearances is { Count: > 0 } appearances)
            {
                <section>
                    <h2>@L["artist.appearsOn"]</h2>
                    <TrackList Tracks="appearances" ShowCover="true" />
                </section>
            }
        </div>
    }
</Loader>

@code {
    [Parameter] public Guid Id { get; set; }

    // Titres phares montrés d'abord ; « Voir tout » déplie la liste complète.
    private const int TopCount = 10;

    private ArtistDetailDto? _artist;
    private List<TrackDto>? _tracks;
    private List<TrackDto>? _appearances;
    private List<ArtistReleaseDto>? _missing;
    private bool _all;
    private bool _favorite;
    private int? _rating;
    private string? _error;
    private Guid _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == Id) return;
        _loaded = Id;
        _artist = null;
        _tracks = null;
        _appearances = null;
        _missing = null;
        _all = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            var artist = Api.ArtistAsync(Id);
            var top = Api.ArtistTopTracksAsync(Id, TopCount);
            var appearances = Api.ArtistAppearancesAsync(Id);
            _artist = await artist;
            _tracks = await top;
            _appearances = await appearances;
            if (_artist is null) _error = L["artist.notFound"];
            else
            {
                _favorite = _artist.IsFavorite;
                _rating = _artist.Rating;
                // Hors de la bibliothèque : réservé aux contributeurs et aux admins.
                if (Auth.CanRequest && _artist.Artist.MusicBrainzId is not null) _missing = await Api.ArtistReleasesAsync(Id);
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = L.Server(ex.Message);
        }
    }

    private async Task ToggleFavoriteAsync()
    {
        if (await Ui.SetArtistFavoriteAsync(Id, !_favorite)) _favorite = !_favorite;
    }

    private async Task RateAsync(int value)
    {
        if (await Ui.SetRatingAsync(Id, value)) _rating = value > 0 ? value : null;
    }

    private async Task ToggleAllAsync()
    {
        try
        {
            _tracks = _all ? await Api.ArtistTopTracksAsync(Id, TopCount) : await Api.ArtistTracksAsync(Id);
            _all = !_all;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }

    private async Task PlayAllAsync(bool shuffle)
    {
        try
        {
            var tracks = await Api.ArtistTracksAsync(Id);
            if (tracks is { Count: > 0 }) await Player.PlayAsync(tracks, shuffle ? -1 : 0, shuffle);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }
}
