<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Une langue par fichier ; un fichier ajouté ici est une langue de plus dans l'application. -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="Localify.Contracts.Localization.%(Filename).json" />
  </ItemGroup>

</Project>
