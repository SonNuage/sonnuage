@implements IDisposable

@* Changer de langue redessine les textes partout (langue en cascade, voir LocalizedComponentBase) sans rien recréer. *@
<CascadingValue Name="@LocalizedComponentBase.LanguageCascade" Value="L.Language">
<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <div class="empty"><p>@L["app.notFound"]</p><a class="btn" href="">@L["nav.home"]</a></div>
        </LayoutView>
    </NotFound>
</Router>
</CascadingValue>

@code {
    protected override void OnInitialized() => L.Changed += Rerender;

    private void Rerender() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= Rerender;
}
