@inject AuthSession Auth
@inject AccountStore Accounts
@inject IServerEndpoint Endpoint
@inject IPlatformInfo Platform

<div class="auth-page">
    <form class="auth-card" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
        <svg viewBox="0 0 64 64" width="56" height="56" aria-hidden="true"><rect width="64" height="64" rx="14" fill="var(--accent)" /><path d="M24 44V20l22 12z" fill="#121212" /></svg>
        <h1>@L["login.title"]</h1>
        @if (Endpoint.IsConfigurable)
        {
            <p class="muted">@L["login.server", ("host", (Accounts.LoginServer ?? Endpoint.BaseAddress)?.Host)] <button type="button" class="link" @onclick="ChangeServerAsync">@L["login.changeServer"]</button></p>
            @if (!Accounts.IsAdding && Accounts.Active is { } expired)
            {
                <p class="muted">@L["login.expired", ("user", expired.Username)]</p>
            }
        }
        <label>
            <span>@L["login.username"]</span>
            <input class="input" @bind="_username" autocomplete="username" autocapitalize="off" required />
        </label>
        <label>
            <span>@L["login.password"]</span>
            <input class="input" type="password" @bind="_password" autocomplete="current-password" required />
        </label>
        @if (_error is not null)
        {
            <p class="form-error">@_error</p>
        }
        <button class="btn primary wide" type="submit" disabled="@_busy">@(_busy ? L["login.submitting"] : L["login.submit"])</button>
        @if (Accounts.CanCancelAdd)
        {
            <button type="button" class="link" @onclick="Accounts.CancelAdd">@L["accounts.cancelAdd", ("account", Accounts.Active!.Label)]</button>
        }
        else if (!Accounts.IsAdding)
        {
            @foreach (var other in Accounts.Accounts.Where(a => a.Id != Accounts.Active?.Id))
            {
                <button type="button" class="link" @onclick="() => Accounts.SwitchAsync(other.Id)">@L["accounts.useOther", ("account", other.Label)]</button>
            }
        }
    </form>
</div>

@code {
    private string _username = "";
    private string _password = "";
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = await Auth.LoginAsync(_username.Trim(), _password, Platform.Name);
        _busy = false;
        if (_error is null) _password = "";
    }

    private Task ChangeServerAsync() => Endpoint.SetAsync(null);
}
