@* Clés d'API de l'extension de navigateur (bouton « Ajouter à Localify » sur YouTube). *@
@inject ApiClient Api
@inject UiState Ui

<section class="panel">
    <h2>Extension de navigateur</h2>
    <p class="muted small">
        L'extension Localify ajoute un bouton « Ajouter à Localify » sur YouTube et YouTube Music (dossier <span class="mono">extension/</span> du dépôt, à charger
        « non empaquetée »). Elle se connecte avec une clé créée ici : la clé permet seulement d'ajouter des vidéos à la file, de s'abonner et d'envoyer
        des cookies YouTube. Elle ne donne accès ni à la bibliothèque ni au reste de l'administration. Une clé cesse de fonctionner dès qu'elle est révoquée,
        ou si son créateur n'est plus administrateur.
    </p>
    <form class="inline-form" @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
        <input class="input" placeholder="Nom (ex. Firefox du salon)" @bind="_name" maxlength="100" autocomplete="off" required />
        <button class="btn primary" type="submit">Créer une clé</button>
    </form>

    @if (_created is { } created)
    {
        <div class="notice" style="margin-top: .6rem">
            <span>Clé « @created.Key.Name » : copiez-la maintenant dans les options de l'extension, elle ne sera plus affichée.</span>
            <input class="input mono" readonly value="@created.Secret" onfocus="this.select()" />
            <button class="btn" @onclick="() => _created = null">Fermer</button>
        </div>
    }

    @if (_keys is { Count: > 0 })
    {
        <div class="table-wrap" style="margin-top: .6rem">
            <table class="table">
                <thead><tr><th>Nom</th><th>Clé</th><th>Créée</th><th>Dernière utilisation</th><th></th></tr></thead>
                <tbody>
                    @foreach (var k in _keys)
                    {
                        <tr @key="k.Id">
                            <td>@k.Name</td>
                            <td class="mono">@k.Prefix…</td>
                            <td>@k.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy") <span class="muted small">par @k.CreatedBy</span></td>
                            <td>@(k.LastUsedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "jamais")</td>
                            <td class="row-actions">
                                <button class="icon-btn danger" title="Révoquer" @onclick="() => _revoking = k"><Icon Name="delete" Size="18" /></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_keys is not null)
    {
        <p class="muted small">Aucune clé.</p>
    }
</section>

<Modal Open="_revoking is not null" OpenChanged="v => { if (!v) _revoking = null; }" Title="Révoquer la clé ?">
    <ChildContent><p>L'extension qui utilise « @_revoking?.Name » ne pourra plus rien envoyer.</p></ChildContent>
    <Footer>
        <button class="btn" @onclick="() => _revoking = null">Annuler</button>
        <button class="btn danger" @onclick="RevokeAsync">Révoquer</button>
    </Footer>
</Modal>

@code {
    private List<ExtensionKeyDto>? _keys;
    private string _name = "";
    private CreatedExtensionKeyDto? _created;
    private ExtensionKeyDto? _revoking;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _keys = await Api.ExtensionKeysAsync() ?? [];
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(ex.Message, true);
        }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        try
        {
            _created = await Api.CreateExtensionKeyAsync(_name.Trim());
            _name = "";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(ex.Message, true);
        }
    }

    private async Task RevokeAsync()
    {
        if (_revoking is not { } key) return;
        _revoking = null;
        try
        {
            await Api.RevokeExtensionKeyAsync(key.Id);
            Ui.Notify("Clé révoquée");
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(ex.Message, true);
        }
    }
}
