@page "/"
@inject ApiClient Api
@inject IPlayer Player
@inject UiState Ui
@inject AuthSession Auth

<PageTitle>Localify</PageTitle>

<div class="page">
    <header class="page-header">
        <h1>@Greeting</h1>
        <button class="btn primary" @onclick="ShuffleAllAsync"><Icon Name="shuffle" Size="18" /> @L["home.shuffleAll"]</button>
    </header>

    <Loader Loading="_home is null && _error is null" Error="@_error" OnRetry="LoadAsync">
        @if (_home is { } home)
        {
            @if (home.Playlists.Count > 0)
            {
                <section>
                    <h2>@L["home.yourPlaylists"]</h2>
                    <div class="chips">
                        <a class="chip" href="favorites"><span class="chip-icon liked"><Icon Name="heart" Size="20" /></span>@L["nav.likedSongs"]</a>
                        @foreach (var p in home.Playlists.Take(7))
                        {
                            <a class="chip" href="playlist/@p.Id">
                                <Cover AlbumId="p.CoverAlbumId" HasCover="p.CoverAlbumId is not null" Size="96" Class="cover-xs" Seed="@p.Name" />
                                @p.Name
                            </a>
                        }
                    </div>
                </section>
            }

            @if (home.RecentlyPlayed.Count > 0)
            {
                <section>
                    <h2>@L["home.recentlyPlayed"]</h2>
                    <TrackList Tracks="home.RecentlyPlayed.Take(10).ToList()" ShowCover="true" />
                </section>
            }

            <section>
                <div class="section-head">
                    <h2>@L["home.recentlyAdded"]</h2>
                    <a href="library/albums" class="link">@L["common.showAll"]</a>
                </div>
                @if (home.RecentlyAdded.Count == 0)
                {
                    <p class="muted">@L["home.emptyLibrary"] @(Auth.IsAdmin ? L["home.emptyLibraryAdmin"] : "")</p>
                }
                <AlbumGrid Albums="home.RecentlyAdded" />
            </section>
        }
    </Loader>
</div>

@code {
    private HomeDto? _home;
    private string? _error;

    private string Greeting => DateTime.Now.Hour switch
    {
        < 5 => L["home.greeting.night"],
        < 18 => L["home.greeting.day"],
        _ => L["home.greeting.evening"],
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _home = await Api.HomeAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = L.Server(ex.Message);
        }
    }

    private async Task ShuffleAllAsync()
    {
        try
        {
            var tracks = await Api.RandomTracksAsync(200);
            if (tracks is { Count: > 0 }) await Player.PlayAsync(tracks, 0, shuffle: false);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }
}
