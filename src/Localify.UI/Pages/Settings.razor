@page "/settings"
@inject AuthSession Auth
@inject ApiClient Api
@inject PlaybackSettings Playback
@inject IPlayer Player
@inject IPlatformInfo Platform
@inject IServerEndpoint Endpoint
@inject UiState Ui

<PageTitle>@L["nav.settings"] · Localify</PageTitle>

<div class="page narrow">
    <header class="page-header"><h1>@L["nav.settings"]</h1></header>

    <section class="panel">
        <h2>@L["settings.language"]</h2>
        <label class="field">
            <span>@L["settings.language"]</span>
            <select class="input" value="@L.Language" @onchange="e => SetLanguageAsync(e.Value?.ToString())">
                @foreach (var lang in L.Available)
                {
                    <option value="@lang.Code">@lang.Name</option>
                }
            </select>
            <small class="muted">@L["settings.languageHint"]</small>
        </label>
    </section>

    <section class="panel">
        <h2>@L["settings.audioQuality"]</h2>
        @if (_info is { TranscodingAvailable: false })
        {
            <p class="muted">@L["settings.noTranscoding"]</p>
        }
        <label class="field">
            <span>@(Platform.HasMeteredNetworkDetection ? L["settings.onWifi"] : L["settings.playbackQuality"])</span>
            <select class="input" @bind="_quality">
                @foreach (var q in Qualities)
                {
                    <option value="@q.Id">@L["quality." + q.Id]</option>
                }
            </select>
        </label>
        @if (Platform.HasMeteredNetworkDetection)
        {
            <label class="field">
                <span>@L["settings.onMobile"]</span>
                <select class="input" @bind="_mobileQuality">
                    @foreach (var q in Qualities)
                    {
                        <option value="@q.Id">@L["quality." + q.Id]</option>
                    }
                </select>
            </label>
        }
        <label class="field">
            <span>@L["settings.prefetch"]</span>
            <input class="input" type="number" min="0" max="10" @bind="_prefetch" />
            <small class="muted">@L["settings.prefetchHint"]</small>
        </label>
        <button class="btn primary" @onclick="SavePlaybackAsync">@L["common.save"]</button>
    </section>

    <section class="panel">
        <h2>@L["settings.account"]</h2>
        <p>@L["settings.loggedInAs"] <strong>@Auth.User?.Username</strong> (@(Auth.IsAdmin ? L["settings.roleAdmin"] : L["settings.roleUser"]))
            @if (Endpoint.IsConfigurable) { <span> @L["settings.onServer", ("host", Endpoint.BaseAddress?.Host)]</span> }</p>
        <form class="stack" @onsubmit="ChangePasswordAsync" @onsubmit:preventDefault="true">
            <input class="input" type="password" placeholder="@L["settings.currentPassword"]" @bind="_current" autocomplete="current-password" required />
            <input class="input" type="password" placeholder="@L["settings.newPassword", ("min", 8)]" @bind="_next" autocomplete="new-password" minlength="8" required />
            <button class="btn" type="submit">@L["settings.changePassword"]</button>
        </form>
        <button class="btn danger" @onclick="Auth.LogoutAsync"><Icon Name="logout" Size="18" /> @L["settings.logout"]</button>
    </section>

    <p class="muted small">Localify @(_info?.Version) · @Platform.Name</p>
</div>

@code {
    private ServerInfoDto? _info;
    private string _quality = "";
    private string _mobileQuality = "";
    private int _prefetch;
    private string _current = "";
    private string _next = "";

    private IReadOnlyList<QualityDto> Qualities => _info?.Qualities ?? [new QualityDto("original", "original", "original", null)];

    protected override async Task OnInitializedAsync()
    {
        _quality = Playback.Quality.ToWire();
        _mobileQuality = Playback.MobileQuality.ToWire();
        _prefetch = Playback.PrefetchCount;
        try
        {
            _info = await Api.InfoAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
        }
    }

    private async Task SavePlaybackAsync()
    {
        StreamQualities.TryParse(_quality, out var q);
        StreamQualities.TryParse(_mobileQuality, out var m);
        await Playback.SaveAsync(q, m, _prefetch);
        await Player.ReloadSettingsAsync();
        Ui.Notify(L["settings.saved"]);
    }

    private async Task SetLanguageAsync(string? code)
    {
        if (string.IsNullOrEmpty(code)) return;
        try
        {
            // Sur le compte d'abord (suivie sur les autres appareils), puis ici : l'interface se redessine.
            if (await Api.SetLanguageAsync(code) is { } user) await Auth.UpdateUserAsync(user);
            await L.SetAsync(code);
            Ui.Notify(L["settings.languageSaved"]);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }

    private async Task ChangePasswordAsync()
    {
        try
        {
            await Api.ChangePasswordAsync(_current, _next);
            Ui.Notify(L["settings.passwordChanged"]);
            await Auth.LogoutAsync();
        }
        catch (ApiException ex)
        {
            Ui.Notify(L.Server(ex.Message), true);
        }
    }
}
