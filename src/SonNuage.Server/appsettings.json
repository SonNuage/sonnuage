{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SonNuage": {
    "MusicPaths": [ "/music" ],
    "UploadPath": "/uploads",
    "DataPath": "/config",
    "FfmpegPath": "ffmpeg",
    "TranscodeCacheMaxMegabytes": 10240,
    "MaxConcurrentTranscodes": 4,
    "ScanIntervalMinutes": 360,
    "WatchFileSystem": true,
    "BehindProxy": true,
    "InitialAdminUser": "admin"
  }
}
