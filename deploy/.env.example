# Image publiée par la CI GitLab (adresse exacte : projet > Deploy > Container Registry)
LOCALIFY_IMAGE=git.pmjb.org:5050/pmj.bailly/localify:latest
# Dossier de musique sur l'hôte (monté en lecture seule)
MUSIC_DIR=/srv/musique
LOCALIFY_ADMIN_USER=admin
LOCALIFY_ADMIN_PASSWORD=changez-moi
LOCALIFY_CACHE_MB=10240
CLOUDFLARE_TUNNEL_TOKEN=
# Recherche Elasticsearch (facultative) : décommenter les deux lignes
# COMPOSE_PROFILES=search
# LOCALIFY_SEARCH_URL=http://elasticsearch:9200
