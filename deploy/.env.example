# Server image, public on GitHub's registry. Pin a version (for example :1.27.1) instead of :latest if you prefer.
SONNUAGE_IMAGE=ghcr.io/sonnuage/sonnuage:latest
# Music folder on the host (mounted read-only)
MUSIC_DIR=/srv/music
SONNUAGE_ADMIN_USER=admin
SONNUAGE_ADMIN_PASSWORD=change-me
SONNUAGE_CACHE_MB=10240
CLOUDFLARE_TUNNEL_TOKEN=
# Elasticsearch search (optional): uncomment both lines
# COMPOSE_PROFILES=search
# SONNUAGE_SEARCH_URL=http://elasticsearch:9200
